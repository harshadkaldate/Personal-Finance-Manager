   ACCOUNTS
   ================================================================ */
function accountBalance(accountId){
  const acc = state.accounts.find(a=>a.id===accountId);
  if(!acc) return 0;
  let bal = acc.startingBalance || 0;
  state.transactions.forEach(t=>{
    if(t.accountId !== accountId) return;
    bal += t.type==='Income' ? t.amount : -t.amount;
  });
  return bal;
}
function netWorth(){
  return state.accounts.reduce((sum,a)=> sum + accountBalance(a.id), 0);
}
function accountName(id){
  const a = state.accounts.find(x=>x.id===id);
  return a ? a.name : 'Unknown';
}

/* ================================================================
   RECURRING TRANSACTIONS
   ================================================================ */
function addInterval(iso, frequency){
  const d = new Date(iso+'T00:00:00');
  if(frequency==='weekly'){
    d.setDate(d.getDate()+7);
  } else {
    const day = d.getDate();
    d.setDate(1);
    d.setMonth(d.getMonth()+1);
    const daysInNewMonth = new Date(d.getFullYear(), d.getMonth()+1, 0).getDate();
    d.setDate(Math.min(day, daysInNewMonth));
  }
  return d.toISOString().slice(0,10);
}

/*
 * Materializes any recurring rule whose next run date has arrived
 * (or passed, e.g. if the app wasn't opened for a while), capped at
 * 36 generated occurrences per rule so a long-dormant rule can't
 * flood the ledger.
 */
function processDueRecurring(){
  const today = todayISO();
  let generated = 0;
  state.recurring.forEach(rule=>{
    if(!rule.active) return;
    let guard = 0;
    while(rule.nextRun <= today && guard < 36){
      state.transactions.push({
        id: uid(), date: rule.nextRun, time: '09:00', type: rule.type,
        category: rule.category, amount: rule.amount, description: rule.description,
        accountId: rule.accountId, recurringId: rule.id
      });
      rule.nextRun = addInterval(rule.nextRun, rule.frequency);
      generated++; guard++;
    }
  });
  return generated;
}
function monthlyNormalizedAmount(rule){
  return rule.frequency==='weekly' ? rule.amount * 4.348 : rule.amount;
}
function forecastNextMonth(){
  let income = 0, expense = 0;
  state.recurring.filter(r=>r.active).forEach(r=>{
    if(r.type==='Income') income += monthlyNormalizedAmount(r);
    else expense += monthlyNormalizedAmount(r);
  });
  return { income, expense };
}

function lastNMonths(n){
  const out = [];
  const d = new Date();
  d.setDate(1);
  for(let i=n-1;i>=0;i--){
    const dt = new Date(d.getFullYear(), d.getMonth()-i, 1);
    out.push({ key: dt.getFullYear()+'-'+String(dt.getMonth()+1).padStart(2,'0'), label: dt.toLocaleString(undefined,{month:'short'}) });
  }
  return out;
}

function monthlySeries(months){
  return months.map(m=>{
    const inMonth = state.transactions.filter(t=>t.date.startsWith(m.key));
    return { label:m.label, income: totalIncome(inMonth), expense: totalExpense(inMonth) };
  });
}

function median(nums){
  if(nums.length===0) return 0;
  const s=[...nums].sort((a,b)=>a-b);
  const mid=Math.floor(s.length/2);
  return s.length%2 ? s[mid] : (s[mid-1]+s[mid])/2;
}

function healthScore(income, expense){
  if(income<=0) return 0;
  let score = Math.round(((income-expense)/income)*100);
  return Math.max(0, Math.min(100, score));
}

function motivationalMessage(positive){
  const good = ["Great! You're saving more than you spend.", "Steady hand on the ledger — keep it up.", "Your savings rate is healthy this month.", "Discipline is compounding in your favor."];
  const caution = ["Expenses are creeping past income — worth a look.", "Consider trimming discretionary categories.", "Your margin is thin this month — review the ledger.", "A tighter budget could help rebalance things."];
  const arr = positive ? good : caution;
  return arr[Math.floor(Math.random()*arr.length)];
}

