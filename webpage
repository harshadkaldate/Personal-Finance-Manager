  {label:'Backup Now', hint:'', icon:'archive', run:()=> backupNow()},
  {label:'Toggle Sound Effects', hint:'', icon:'soundOn', run: async ()=>{ state.soundEnabled=!state.soundEnabled; unlockAudio(); await saveState(); renderShell(); }},
];

/* Parses free text into a quick-add transaction guess. Returns null
   if no numeric amount is found (so the palette falls back to the
   navigation/action list instead). */
function parseQuickAdd(text){
  const numMatch = text.match(/(\d+(\.\d+)?)/);
  if(!numMatch) return null;
  const amount = parseFloat(numMatch[1]);
  if(!amount || amount<=0) return null;

  const lower = text.toLowerCase();
  let type = 'Expense';
  if(/\b(income|in|received|got|earned|salary|\+)\b/.test(lower)) type = 'Income';
  if(/\b(expense|spent|paid|out|bought|-)\b/.test(lower) && !/\bincome\b/.test(lower)) type = 'Expense';

  const words = lower.replace(numMatch[0], ' ').replace(/[^a-z0-9\s]/g,' ').split(/\s+/).filter(Boolean);
  const skip = new Set(['income','expense','in','out','received','spent','paid','got','earned','bought','for','a','an','the','on']);
  let category = null;
  for(const w of words){
    if(CATEGORY_SYNONYMS[w]){ category = CATEGORY_SYNONYMS[w]; break; }
  }
  const cats = type==='Income' ? INCOME_CATEGORIES : EXPENSE_CATEGORIES;
  if(!category || !cats.includes(category)){
    category = type==='Income' ? 'Other' : 'Other';
  }
  const descWords = words.filter(w=>!skip.has(w));
  const description = descWords.length ? descWords.join(' ').replace(/\b\w/g, c=>c.toUpperCase()) : (type==='Income'?'Income':'Expense');

  return { type, amount: Math.round(amount*100)/100, category, description };
}

let cmdkSelIndex = 0;
function openCmdk(){
  let wrap = document.getElementById('cmdk-wrap');
  if(!wrap){
    wrap = document.createElement('div');
    wrap.id = 'cmdk-wrap';
    wrap.className = 'cmdk-wrap';
    wrap.innerHTML = `
      <div class="cmdk">
        <div class="cmdk-input-row">${ICONS.search}<input id="cmdk-input" placeholder="Type to navigate, or try “expense 12 coffee”…" autocomplete="off"><span class="cmdk-hint">Esc</span></div>
        <div class="cmdk-body" id="cmdk-body"></div>
      </div>`;
    document.body.appendChild(wrap);
    wrap.addEventListener('click', e=>{ if(e.target===wrap) closeCmdk(); });
    document.getElementById('cmdk-input').addEventListener('input', renderCmdkResults);
    document.getElementById('cmdk-input').addEventListener('keydown', handleCmdkKeydown);
  }
  document.getElementById('cmdk-input').value = '';
  renderCmdkResults();
  wrap.classList.add('open');
  setTimeout(()=> document.getElementById('cmdk-input').focus(), 50);
}
function closeCmdk(){
  const wrap = document.getElementById('cmdk-wrap');
  if(wrap) wrap.classList.remove('open');
}
function renderCmdkResults(){
  const input = document.getElementById('cmdk-input');
  const body = document.getElementById('cmdk-body');
  const text = input.value.trim();
  cmdkSelIndex = 0;

  const parsed = text.length>1 ? parseQuickAdd(text) : null;

  if(parsed){
    body.innerHTML = `
      <div class="cmdk-preview">
        <div class="row"><span class="pill ${parsed.type==='Income'?'income':'expense'}">${parsed.type}</span><span class="amt mono" style="color:${parsed.type==='Income'?'var(--income)':'var(--expense)'}">${fmtMoney(parsed.amount)}</span></div>
        <div style="display:flex; justify-content:space-between; font-size:12.5px; color:var(--ink-muted);"><span class="cat-chip"><span class="dot" style="background:${catColor(parsed.category)}"></span>${parsed.category}</span><span>${escapeHtml(parsed.description)}</span></div>
      </div>
      <div class="cmdk-item sel" id="cmdk-confirm" data-quickadd="1">${ICONS.plus} Add this ${parsed.type.toLowerCase()} <span class="cmdk-sub">Enter</span></div>
    `;
    document.getElementById('cmdk-confirm').addEventListener('click', ()=> confirmCmdkQuickAdd(parsed));
    return;
  }

  const filtered = CMDK_ACTIONS.filter(a=> !text || a.label.toLowerCase().includes(text.toLowerCase()));
  if(filtered.length===0){
    body.innerHTML = `<div class="cmdk-empty">No matches. Try including a number to quick-add a transaction, e.g. "coffee 5".</div>`;
    return;
  }
  body.innerHTML = `
    <div class="cmdk-section-label">Jump to / Do</div>
    ${filtered.map((a,i)=>`
      <div class="cmdk-item ${i===0?'sel':''}" data-idx="${i}">${ICONS[a.icon]}<span>${a.label}</span>${a.hint?`<span class="cmdk-sub">${a.hint}</span>`:''}</div>
    `).join('')}
  `;
  body.querySelectorAll('[data-idx]').forEach(el=>{
    el.addEventListener('click', ()=>{ filtered[Number(el.dataset.idx)].run(); closeCmdk(); });
  });
}
async function confirmCmdkQuickAdd(parsed){
  const tx = { id: uid(), date: todayISO(), time: nowHM(), type: parsed.type, category: parsed.category, amount: parsed.amount, description: parsed.description, accountId: state.defaultAccountId };
  state.transactions.push(tx);
  await saveState();
  playStamp(parsed.type, parsed.type==='Income'?'Received':'Recorded', parsed.amount);
  closeCmdk();
  renderShell(); renderView();
}
function handleCmdkKeydown(e){
  const body = document.getElementById('cmdk-body');
  if(e.key==='Escape'){ closeCmdk(); return; }
  if(e.key==='Enter'){
    const sel = body.querySelector('.cmdk-item.sel');
    if(sel){ sel.click(); }
    return;
  }
  if(e.key==='ArrowDown' || e.key==='ArrowUp'){
    e.preventDefault();
    const items = [...body.querySelectorAll('.cmdk-item')];
    if(items.length===0) return;
    let idx = items.findIndex(i=>i.classList.contains('sel'));
    items[idx]?.classList.remove('sel');
    idx = e.key==='ArrowDown' ? Math.min(items.length-1, idx+1) : Math.max(0, idx-1);
    items[idx].classList.add('sel');
    items[idx].scrollIntoView({block:'nearest'});
  }
}

/* ================================================================
   INIT
   ================================================================ */
document.addEventListener('keydown', (e)=>{
  const isMeta = e.metaKey || e.ctrlKey;
  if(isMeta && e.key.toLowerCase()==='k'){ e.preventDefault(); openCmdk(); return; }
  if(e.target.tagName==='INPUT' || e.target.tagName==='TEXTAREA' || e.target.tagName==='SELECT') return;
  const map = {d:'dashboard', l:'ledger', c:'accounts', u:'recurring', a:'analytics', b:'budget', g:'goals', r:'reports', s:'settings'};
  const key = e.key.toLowerCase();
  if(map[key]){ view = map[key]; renderShell(); renderView(); }
  if(key==='n'){ openTxDrawer('Expense'); }
  if(key==='escape'){ closeTxDrawer(); closeCmdk(); closeRecap(); const mw=document.getElementById('modal-wrap'); if(mw) mw.classList.remove('open'); }
});

async function init(){
  renderShell();
  renderView();
  await loadState();
  renderShell();
  renderView();
}
init();
</script>
