function renderAnalytics(){
  const tx = state.transactions;
  if(tx.length===0){
    return `<div class="panel" style="margin-top:14px"><div class="empty">${ICONS.empty}<h4>No data to analyze yet</h4><p>Add a few transactions and this page fills with category breakdowns and statistics.</p></div></div>`;
