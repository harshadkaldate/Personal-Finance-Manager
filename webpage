/* ================================================================
   VIEW: BUDGET
   ================================================================ */
function renderBudget(){
  const thisMonth = todayISO().slice(0,7);
  const monthTx = state.transactions.filter(t=>t.date.startsWith(thisMonth));
  const spent = totalExpense(monthTx);
  const budget = state.monthlyBudget || 0;
  const frac = budget>0 ? spent/budget : 0;
  const remaining = budget - spent;
  const color = frac>=1 ? '#D9694C' : frac>=0.9 ? '#D9694C' : frac>=0.8 ? '#E0B84B' : '#5FBE8A';
  const statusText = frac>=1 ? 'Budget exceeded' : frac>=0.9 ? 'Critical — nearly out of budget' : frac>=0.8 ? 'Warning — approaching your limit' : 'Within budget';

  const months = lastNMonths(6);
  const hist = months.map(m=>{
    const t = totalExpense(state.transactions.filter(x=>x.date.startsWith(m.key)));
    return { label:m.label, val: budget>0 ? Math.min(t/budget*100,130) : 0, spent:t };
  });

  return `
    <div class="grid grid-12" style="margin-top:14px">
      <div class="panel span-5">
        <div class="panel-head"><div><div class="eyebrow">${monthLabel(todayISO())}</div><h3>Budget Gauge</h3></div></div>
        <div class="panel-pad gauge-wrap">
          <svg width="240" height="140" viewBox="0 0 240 140">
            <path d="M20 130 A100 100 0 0 1 220 130" fill="none" stroke="rgba(237,234,224,0.08)" stroke-width="16" stroke-linecap="round"/>
            <path id="gauge-arc" d="M20 130 A100 100 0 0 1 220 130" fill="none" stroke="${color}" stroke-width="16" stroke-linecap="round"
              stroke-dasharray="314" stroke-dashoffset="314"/>
          </svg>
          <div class="gauge-value mono" style="color:${color}">${budget>0 ? Math.round(frac*100)+'%' : '—'}</div>
          <div class="gauge-label">${budget>0 ? statusText : 'No budget set'}</div>
        </div>
        <div class="divider" style="margin:0 22px"></div>
        <div class="panel-pad" style="display:flex; flex-direction:column; gap:12px;">
          <div class="field"><label>Monthly budget</label>
            <div style="display:flex; gap:8px;">
              <input class="mono-input" id="budget-input" type="number" step="0.01" min="0" placeholder="0.00" value="${budget||''}">
              <button class="btn btn-primary btn-sm" id="budget-save">Save</button>
            </div>
          </div>
          ${budget>0 ? `
          <div class="kpi-row" style="justify-content:space-between; font-size:13px;"><span style="color:var(--ink-muted)">Spent this month</span><span class="mono" style="font-weight:600">${fmtMoney(spent)}</span></div>
          <div class="kpi-row" style="justify-content:space-between; font-size:13px;"><span style="color:var(--ink-muted)">Remaining</span><span class="mono" style="font-weight:600; color:${remaining>=0?'var(--income)':'var(--expense)'}">${fmtMoney(remaining)}</span></div>
          ` : ''}
        </div>
      </div>

      <div class="panel span-7">
        <div class="panel-head"><div><div class="eyebrow">Last 6 months</div><h3>Budget Usage Trend</h3></div></div>
        <div class="panel-pad">
          ${budget<=0 ? `<div class="empty" style="padding:40px 10px">${ICONS.budget}<h4>Set a budget to unlock this view</h4><p>Once you set a monthly budget, we'll track how each month compares.</p></div>` :
          hist.map(h=>{
            const c = h.val>=100?'#D9694C':h.val>=80?'#E0B84B':'#5FBE8A';
            return `<div class="tally-row"><span class="cat-name">${h.label}</span><div class="tally-track"><div class="tally-fill" data-target="${Math.min(h.val,100)}" style="background:${c}"></div></div><span class="tally-val">${fmtMoney(h.spent)}</span></div>`;
          }).join('')}
        </div>
      </div>
    </div>
  `;
}
afterRender.budget = function(){
  const input = document.getElementById('budget-input');
  const saveBtn = document.getElementById('budget-save');
  if(saveBtn) saveBtn.addEventListener('click', async ()=>{
    const val = parseFloat(input.value);
    if(!val || val<=0){ toast('Enter a budget greater than zero.', 'error'); return; }
    state.monthlyBudget = Math.round(val*100)/100;
    await saveState();
    toast('Budget updated.', 'success');
    renderShell(); renderView();
  });
  requestAnimationFrame(()=>{
    document.querySelectorAll('.tally-fill[data-target]').forEach(el=> el.style.width = el.dataset.target+'%');
    const arc = document.getElementById('gauge-arc');
    if(arc){
      const thisMonth = todayISO().slice(0,7);
      const spent = totalExpense(state.transactions.filter(t=>t.date.startsWith(thisMonth)));
      const frac = state.monthlyBudget>0 ? Math.min(spent/state.monthlyBudget,1) : 0;
      const len = 314;
      arc.style.transition = reduceMotion ? 'none' : 'stroke-dashoffset 1000ms cubic-bezier(.22,.68,.16,1)';
      requestAnimationFrame(()=>{ arc.style.strokeDashoffset = String(len - (len*frac)); });
    }
  });
};

/* ================================================================
   VIEW: GOALS (savings prediction)
   ================================================================ */
function renderGoals(){
  const income = totalIncome(state.transactions);
  const expense = totalExpense(state.transactions);
  const currentSavings = income - expense;
  return `
    <div class="grid grid-12" style="margin-top:14px">
      <div class="panel span-5 panel-pad">
        <div class="eyebrow" style="margin-bottom:14px">Plan a goal</div>
        <div style="display:flex; flex-direction:column; gap:14px;">
          <div class="field"><label>Target amount</label><input class="mono-input" id="goal-target" type="number" min="1" step="0.01" placeholder="e.g. 5000"></div>
          <div class="field"><label>Expected average monthly savings</label>
            <input class="mono-input" id="goal-monthly" type="number" min="0.01" step="0.01" placeholder="e.g. 400" value="${currentSavings>0?currentSavings.toFixed(2):''}">
            <div class="hint" style="color:var(--ink-faint)">${currentSavings>0 ? `Prefilled from your current net savings of ${fmtMoney(currentSavings)}.` : ''}</div>
          </div>
          <button class="btn btn-primary" id="goal-calc">${ICONS.target} Calculate</button>
        </div>
      </div>
      <div class="panel span-7" id="goal-result">
        <div class="empty">${ICONS.target}<h4>Set a target to see your timeline</h4><p>Enter a goal and a monthly savings rate — we'll estimate how many months it will take.</p></div>
      </div>
    </div>
  `;
}
afterRender.goals = function(){
  document.getElementById('goal-calc').addEventListener('click', ()=>{
    const target = parseFloat(document.getElementById('goal-target').value);
    const monthly = parseFloat(document.getElementById('goal-monthly').value);
    const resultEl = document.getElementById('goal-result');
    if(!target || target<=0 || !monthly || monthly<=0){
      toast('Enter a valid target and monthly savings amount.', 'error');
      return;
    }
    const months = Math.ceil(target/monthly);
    const years = Math.floor(months/12), remMonths = months%12;
    let tone, toneColor, message;
    if(months<=6){ tone='Achievable'; toneColor='var(--income)'; message="That's a very achievable short-term goal!"; }
    else if(months<=24){ tone='Steady'; toneColor='var(--warn)'; message='A solid mid-term goal — stay consistent.'; }
    else { tone='Long-term'; toneColor='var(--expense)'; message='This is a long-term goal — consider increasing your monthly savings.'; }

    const pct = Math.min(100, (monthly*months>0 ? 100 : 0));
    resultEl.innerHTML = `
      <div class="panel-head"><div><div class="eyebrow">Projection</div><h3>Timeline to ${fmtMoney(target)}</h3></div><span class="pill" style="background:${toneColor}22; color:${toneColor}">${tone}</span></div>
      <div class="panel-pad">
        <div class="hero-figure mono" style="font-size:44px;"><span id="goal-months">0</span><span class="unit">months</span></div>
        <p class="hero-sub" style="margin-top:8px;">≈ ${years>0?years+' yr '+remMonths+' mo':months+' months'} at ${fmtMoney(monthly)}/month.</p>
        <div class="tally-track" style="margin-top:18px; height:12px;"><div class="tally-fill" data-target="100" style="background:${toneColor}"></div></div>
        <p style="margin-top:16px; color:var(--ink-muted); font-size:13px;">${message}</p>
      </div>
    `;
    const monthsEl = document.getElementById('goal-months');
    animateNumber(monthsEl, months, {decimals:0, prefix:''});
    requestAnimationFrame(()=>{ resultEl.querySelector('.tally-fill').style.width='100%'; });
  });
};

/* ================================================================
   VIEW: REPORTS
   ================================================================ */
function renderReports(){
  const tx = state.transactions;
  const income = totalIncome(tx), expense = totalExpense(tx), savings = income-expense;
  const catTotals = categoryTotals('Expense');
  const largestExpense = [...tx].filter(t=>t.type==='Expense').sort((a,b)=>b.amount-a.amount)[0];
  const largestIncome = [...tx].filter(t=>t.type==='Income').sort((a,b)=>b.amount-a.amount)[0];
  const score = healthScore(income, expense);
  const budget = state.monthlyBudget || 0;
  const budgetStatus = budget<=0 ? 'No budget configured' : (expense/budget>=1 ? 'BUDGET EXCEEDED' : expense/budget>=0.9 ? 'CRITICAL' : expense/budget>=0.8 ? 'WARNING' : 'Within budget');

  const generatedAt = new Date().toLocaleString();

  return `
    <div class="panel no-print" style="margin-top:14px; padding:16px 22px; display:flex; justify-content:space-between; align-items:center;">
      <p style="color:var(--ink-muted); font-size:13px;">A print-ready statement, generated from your current ledger.</p>
      <div style="display:flex; gap:10px;">
        <button class="btn btn-ghost btn-sm" id="export-json">${ICONS.down} Export JSON</button>
        <button class="btn btn-ghost btn-sm" id="export-csv">${ICONS.down} Export CSV</button>
        <button class="btn btn-primary btn-sm" id="print-report">${ICONS.print} Print / Save PDF</button>
      </div>
    </div>

    <div class="panel" style="margin-top:16px;" id="report-sheet">
      <div class="panel-pad">
        <div style="text-align:center; margin-bottom:22px;">
          <h3 style="font-size:22px;">Personal Finance Report</h3>
          <p style="color:var(--ink-faint); font-size:12px; margin-top:6px;" class="mono">Generated ${generatedAt}</p>
        </div>
        <div class="grid grid-3">
          <div class="stat-card panel"><span class="eyebrow">Total Income</span><span class="stat-val mono" style="color:var(--income)">${fmtMoney(income)}</span></div>
          <div class="stat-card panel"><span class="eyebrow">Total Expense</span><span class="stat-val mono" style="color:var(--expense)">${fmtMoney(expense)}</span></div>
          <div class="stat-card panel"><span class="eyebrow">Net Savings</span><span class="stat-val mono" style="color:${savings>=0?'var(--income)':'var(--expense)'}">${fmtMoney(savings)}</span></div>
        </div>

        <div class="divider" style="margin:24px 0;"></div>
        <div class="grid grid-2">
          <div>
            <div class="eyebrow" style="margin-bottom:10px;">Budget Status</div>
            <p class="statement">Monthly Budget : <b>${budget>0?fmtMoney(budget):'—'}</b>
Status         : <b>${budgetStatus}</b></p>
            <div class="eyebrow" style="margin:18px 0 10px;">Largest Transactions</div>
            <p class="statement">Largest Expense : <b>${largestExpense?fmtMoney(largestExpense.amount)+' ('+largestExpense.category+')':'—'}</b>
Largest Income  : <b>${largestIncome?fmtMoney(largestIncome.amount)+' ('+largestIncome.category+')':'—'}</b></p>
          </div>
          <div>
            <div class="eyebrow" style="margin-bottom:10px;">Category Breakdown</div>
            ${catTotals.length===0 ? '<p style="color:var(--ink-faint); font-size:13px;">No expenses recorded.</p>' :
              catTotals.map(([c,v])=>`<div style="display:flex; justify-content:space-between; font-family:var(--font-mono); font-size:12.5px; padding:4px 0; color:var(--ink-muted);"><span>${c}</span><span>${fmtMoney(v)} (${(v/expense*100).toFixed(1)}%)</span></div>`).join('')}
          </div>
        </div>

        <div class="divider" style="margin:24px 0;"></div>
        <div style="text-align:center;">
          <div class="eyebrow">Financial Health Score</div>
          <div class="health-score mono" style="color:${score>=60?'var(--income)':score>=30?'var(--warn)':'var(--expense)'}">${score}<span style="font-size:18px; color:var(--ink-faint);">/100</span></div>
        </div>
      </div>
    </div>
  `;
}
afterRender.reports = function(){
  document.getElementById('print-report').addEventListener('click', ()=> window.print());
  document.getElementById('export-json').addEventListener('click', ()=>{
    downloadFile('finance-manager-export.json', JSON.stringify(state, null, 2), 'application/json');
  });
  document.getElementById('export-csv').addEventListener('click', ()=>{
    const rows = [['ID','Date','Time','Type','Category','Amount','Description']];
    sortedTx().forEach(t=> rows.push([t.id,t.date,t.time,t.type,t.category,t.amount,'"'+t.description.replace(/"/g,'""')+'"']));
    const csv = rows.map(r=>r.join(',')).join('\n');
    downloadFile('finance-manager-transactions.csv', csv, 'text/csv');
  });
};
function downloadFile(filename, content, mime){
  const blob = new Blob([content], {type:mime});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename; document.body.appendChild(a); a.click();
  a.remove(); URL.revokeObjectURL(url);
  toast('Downloaded ' + filename, 'success');
}

/* ================================================================
   VIEW: SETTINGS
   ================================================================ */
function renderSettings(){
  return `
    <div class="grid grid-12" style="margin-top:14px">
      <div class="panel span-6">
        <div class="panel-head"><div><div class="eyebrow">Data</div><h3>Backup &amp; Restore</h3></div></div>
        <div class="panel-pad" style="display:flex; flex-direction:column; gap:12px;">
          <p style="color:var(--ink-muted); font-size:13px;">Snapshots are stored securely and privately in your Claude account, separate from your live ledger.</p>
          <p style="font-size:12px; color:var(--ink-faint);" class="mono">Last backup: ${state.lastBackupAt ? new Date(state.lastBackupAt).toLocaleString() : 'never'}</p>
          <div style="display:flex; gap:10px;">
            <button class="btn btn-primary" id="btn-backup">${ICONS.archive} Backup Now</button>
            <button class="btn btn-ghost" id="btn-restore">Restore From Backup</button>
          </div>
          <div class="divider"></div>
          <button class="btn btn-danger" id="btn-reset">Clear All Data</button>
        </div>
      </div>
      <div class="panel span-6">
        <div class="panel-head"><div><div class="eyebrow">Preferences</div><h3>Display</h3></div></div>
        <div class="panel-pad" style="display:flex; flex-direction:column; gap:14px;">
          <div class="field">
            <label>Currency symbol</label>
            <select id="pref-currency">
              ${['$','₹','€','£','¥'].map(c=>`<option value="${c}" ${state.currency===c?'selected':''}>${c}</option>`).join('')}
            </select>
          </div>
          <p style="color:var(--ink-faint); font-size:12px;">Everything is stored automatically as you go — there's no separate save step.</p>
        </div>
      </div>
    </div>
  `;
}
afterRender.settings = function(){
  document.getElementById('btn-backup').addEventListener('click', backupNow);
  document.getElementById('btn-restore').addEventListener('click', ()=>{
    showModal({ title:'Restore from backup?', body:'This replaces everything currently in your ledger with the last backup. This can\'t be undone.',
      confirmLabel:'Restore', confirmClass:'btn-danger', onConfirm: restoreFromBackup });
  });
  document.getElementById('btn-reset').addEventListener('click', ()=>{
    showModal({ title:'Clear all data?', body:'This permanently deletes every transaction and resets your budget. Consider backing up first.',
      confirmLabel:'Clear everything', confirmClass:'btn-danger', onConfirm: async ()=>{
        state = { transactions:[], nextId:1001, monthlyBudget:0, currency:state.currency, lastBackupAt:state.lastBackupAt };
        await saveState();
        toast('All data cleared.', 'success');
        view='dashboard'; renderShell(); renderView();
      }});
  });
  document.getElementById('pref-currency').addEventListener('change', async (e)=>{
    state.currency = e.target.value;
    await saveState();
    renderView();
  });
};

/* ================================================================
   INIT
   ================================================================ */
document.addEventListener('keydown', (e)=>{
  if(e.target.tagName==='INPUT' || e.target.tagName==='TEXTAREA' || e.target.tagName==='SELECT') return;
  const map = {d:'dashboard', l:'ledger', a:'analytics', b:'budget', g:'goals', r:'reports', s:'settings'};
  const key = e.key.toLowerCase();
  if(map[key]){ view = map[key]; renderShell(); renderView(); }
  if(key==='n'){ openTxDrawer('Expense'); }
  if(key==='escape'){ closeTxDrawer(); const mw=document.getElementById('modal-wrap'); if(mw) mw.classList.remove('open'); }
});

async function init(){
  renderShell();
  renderView();
  await loadState();
  renderShell();
  renderView();
}
init();
</script>
