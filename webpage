      </div>
      <div class="panel span-4">
        <div class="panel-head"><div><div class="eyebrow">Next 5</div><h3>Coming Up</h3></div></div>
        <div class="panel-pad">
          ${upcoming.length===0 ? `<p style="color:var(--ink-faint); font-size:12.5px;">No active rules yet.</p>` :
            upcoming.map(r=>`<div class="upcoming-chip"><span>${escapeHtml(r.description)}</span><span class="mono" style="color:${r.type==='Income'?'var(--income)':'var(--expense)'}">${fmtDateDisplay(r.nextRun)}</span></div>`).join('')}
        </div>
        <div class="divider" style="margin:0 20px;"></div>
        <div class="panel-pad">
          <div class="eyebrow" style="margin-bottom:10px;">Next Month Forecast</div>
          <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;"><span style="color:var(--ink-muted)">Projected income</span><span class="mono" style="color:var(--income); font-weight:600;">${fmtMoney(forecast.income)}</span></div>
          <div style="display:flex; justify-content:space-between; font-size:13px;"><span style="color:var(--ink-muted)">Projected expense</span><span class="mono" style="color:var(--expense); font-weight:600;">${fmtMoney(forecast.expense)}</span></div>
          <p style="font-size:11.5px; color:var(--ink-faint); margin-top:10px;">Based on active recurring rules only — not a full prediction.</p>
