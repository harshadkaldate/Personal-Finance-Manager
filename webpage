                <div class="rec-sub">${r.category} · ${r.frequency==='weekly'?'Weekly':'Monthly'} · next ${fmtDateDisplay(r.nextRun)} · ${accountName(r.accountId)}</div>
              </div>
              <div class="rec-amt" style="color:${r.type==='Income'?'var(--income)':'var(--expense)'}">${r.type==='Income'?'+':'−'}${fmtMoney(r.amount)}</div>
              <div class="rec-toggle ${r.active?'active':''}" data-toggle-rec="${r.id}" title="${r.active?'Pause':'Resume'}"></div>
              <button class="icon-btn" data-edit-rec="${r.id}">${ICONS.edit}</button>
              <button class="icon-btn danger" data-del-rec="${r.id}">${ICONS.trash}</button>
