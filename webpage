afterRender.recurring = function(){
  const addBtn = document.getElementById('btn-add-recurring');
  if(addBtn) addBtn.addEventListener('click', ()=>openRecurringDrawer());
  document.querySelectorAll('[data-edit-rec]').forEach(b=>b.addEventListener('click', e=>openRecurringDrawer(Number(e.currentTarget.dataset.editRec))));
  document.querySelectorAll('[data-del-rec]').forEach(b=>b.addEventListener('click', e=>{
    const id = Number(e.currentTarget.dataset.delRec);
    showModal({ title:'Delete this recurring rule?', body:'Future occurrences will stop. Already-logged transactions stay in your ledger.', confirmLabel:'Delete', confirmClass:'btn-danger',
      onConfirm: async ()=>{ state.recurring = state.recurring.filter(r=>r.id!==id); await saveState(); toast('Rule deleted.','success'); renderView(); }});
  }));
  document.querySelectorAll('[data-toggle-rec]').forEach(b=>b.addEventListener('click', async e=>{
    const id = Number(e.currentTarget.dataset.toggleRec);
    const rule = state.recurring.find(r=>r.id===id);
    rule.active = !rule.active;
    await saveState();
    renderView();
  }));
};

function openRecurringDrawer(editId){
  const existing = editId ? state.recurring.find(r=>r.id===editId) : null;
  const type = existing ? existing.type : 'Expense';
  let scrim = document.getElementById('drawer-scrim');
  if(!scrim){ scrim = document.createElement('div'); scrim.id='drawer-scrim'; scrim.className='scrim'; document.body.appendChild(scrim); }
  let drawer = document.getElementById('tx-drawer');
  if(!drawer){ drawer = document.createElement('div'); drawer.id='tx-drawer'; drawer.className='drawer'; document.body.appendChild(drawer); }

  const cats = type==='Income' ? INCOME_CATEGORIES : EXPENSE_CATEGORIES;
  drawer.innerHTML = `
    <div class="drawer-head"><h3>${existing?'Edit Rule':'New Recurring Rule'}</h3><button class="icon-btn" id="drawer-close">${ICONS.x}</button></div>
    <div class="drawer-body">
      <div class="toggle-group" id="rec-type-toggle" style="align-self:flex-start">
        <button data-type="Income" class="${type==='Income'?'active':''}">Income</button>
        <button data-type="Expense" class="${type==='Expense'?'active':''}">Expense</button>
      </div>
      <div class="field"><label>Description</label><input id="rec-desc" placeholder="e.g. Rent, Netflix, Salary" value="${existing?escapeHtml(existing.description):''}"></div>
      <div class="field"><label>Category</label><select id="rec-category">${cats.map(c=>`<option value="${c}" ${existing&&existing.category===c?'selected':''}>${c}</option>`).join('')}</select></div>
      <div class="field"><label>Amount</label><input class="mono-input" id="rec-amount" type="number" step="0.01" min="0.01" value="${existing?existing.amount:''}"></div>
      <div class="field"><label>Frequency</label>
        <select id="rec-frequency">
          <option value="monthly" ${!existing||existing.frequency==='monthly'?'selected':''}>Monthly</option>
          <option value="weekly" ${existing&&existing.frequency==='weekly'?'selected':''}>Weekly</option>
        </select>
      </div>
      <div class="field"><label>${existing?'Next run':'Starts on'}</label><input type="date" id="rec-start" value="${existing?existing.nextRun:todayISO()}"></div>
      ${state.accounts.length>1 ? `
      <div class="field"><label>Account</label><select id="rec-account">${state.accounts.map(a=>`<option value="${a.id}" ${(existing?existing.accountId:state.defaultAccountId)===a.id?'selected':''}>${escapeHtml(a.name)}</option>`).join('')}</select></div>
      ` : `<input type="hidden" id="rec-account" value="${state.defaultAccountId}">`}
    </div>
    <div class="drawer-foot">
      <button class="btn btn-ghost" id="drawer-cancel">Cancel</button>
      <button class="btn ${type==='Income'?'btn-income':'btn-expense'}" id="drawer-save">${existing?'Save Changes':'Create Rule'}</button>
    </div>
  `;
  let currentType = type;
  document.getElementById('rec-type-toggle').querySelectorAll('button').forEach(b=>b.addEventListener('click', ()=>{
    currentType = b.dataset.type;
    document.getElementById('rec-type-toggle').querySelectorAll('button').forEach(x=>x.classList.toggle('active', x===b));
    const catSel = document.getElementById('rec-category');
    const newCats = currentType==='Income' ? INCOME_CATEGORIES : EXPENSE_CATEGORIES;
    catSel.innerHTML = newCats.map(c=>`<option value="${c}">${c}</option>`).join('');
    document.getElementById('drawer-save').className = 'btn ' + (currentType==='Income'?'btn-income':'btn-expense');
  }));
  document.getElementById('drawer-close').addEventListener('click', closeTxDrawer);
  document.getElementById('drawer-cancel').addEventListener('click', closeTxDrawer);
  document.getElementById('drawer-save').addEventListener('click', async ()=>{
    const descEl = document.getElementById('rec-desc');
    const amtEl = document.getElementById('rec-amount');
    const amount = parseFloat(amtEl.value);
    if(!descEl.value.trim() || !amount || amount<=0){
      if(!descEl.value.trim()) descEl.closest('.field').classList.add('invalid');
      if(!amount || amount<=0) amtEl.closest('.field').classList.add('invalid');
      toast('Fill in a description and an amount greater than zero.', 'error');
      return;
    }
    const rule = {
      id: existing ? existing.id : state.nextRecurringId++,
      type: currentType,
      category: document.getElementById('rec-category').value,
      amount: Math.round(amount*100)/100,
      description: descEl.value.trim(),
      frequency: document.getElementById('rec-frequency').value,
      nextRun: document.getElementById('rec-start').value,
      accountId: Number(document.getElementById('rec-account').value) || state.defaultAccountId,
      active: existing ? existing.active : true,
    };
    if(existing){
      Object.assign(existing, rule);
      toast('Recurring rule updated.', 'success');
    } else {
      state.recurring.push(rule);
      toast('Recurring rule created.', 'success');
    }
    await saveState();
    closeTxDrawer();
    renderShell(); renderView();
  });
  requestAnimationFrame(()=>{ scrim.classList.add('open'); drawer.classList.add('open'); });
  scrim.onclick = closeTxDrawer;
}

/* ================================================================
   RECAP ("Year in Money")
   A full-screen, scroll-reveal summary — celebratory rather than
   clinical, distinct from the plain Reports statement.
   ================================================================ */
function openRecap(){
  const tx = state.transactions;
  if(tx.length===0){ toast('Add a few transactions first — the recap needs something to celebrate.', 'error'); return; }

  const income = totalIncome(tx), expense = totalExpense(tx), savings = income-expense;
  const catTotals = categoryTotals('Expense');
  const topCat = catTotals[0];
  const biggestExpense = [...tx].filter(t=>t.type==='Expense' && !isTransfer(t)).sort((a,b)=>b.amount-a.amount)[0];
  const score = healthScore(income, expense);

  const months = lastNMonths(12);
  const series = monthlySeries(months).map((s,i)=>({ ...s, key: months[i].key }));
  const withData = series.filter(s=> s.income>0 || s.expense>0);
  let bestMonth = null;
  withData.forEach(s=>{ const net = s.income-s.expense; if(!bestMonth || net > bestMonth.net) bestMonth = { ...s, net }; });
  const positiveMonths = withData.filter(s=> s.income >= s.expense).length;

  let overlay = document.getElementById('recap-overlay');
  if(!overlay){ overlay = document.createElement('div'); overlay.id='recap-overlay'; overlay.className='recap-overlay'; document.body.appendChild(overlay); }

  overlay.innerHTML = `
    <button class="btn btn-ghost recap-close" id="recap-close">${ICONS.x} Close</button>
    <div class="recap-wrap">
      <div class="recap-section">
        <div class="recap-kicker">Your Ledger, In Review</div>
        <div class="recap-big">Here's where<br>your money went.</div>
        <p class="recap-sub">Across <b style="color:var(--ink)">${tx.length}</b> recorded entries, here's the story your ledger tells.</p>
      </div>

      <div class="recap-section">
        <div class="recap-kicker">Total Flow</div>
        <div class="recap-big mono" style="color:var(--income)">${state.currency}<span id="recap-income">0</span></div>
        <p class="recap-sub">came in, against <b class="mono" style="color:var(--expense)">${fmtMoney(expense)}</b> that went out.</p>
        <div class="recap-badge">${savings>=0?'You came out ahead: '+fmtMoney(savings):'A deficit of '+fmtMoney(Math.abs(savings))}</div>
      </div>

      ${topCat ? `
      <div class="recap-section">
        <div class="recap-kicker">Top Category</div>
        <div class="recap-big" style="color:${catColor(topCat[0])}">${escapeHtml(topCat[0])}</div>
        <p class="recap-sub">took the largest share of your spending at <b class="mono" style="color:var(--ink)">${fmtMoney(topCat[1])}</b>.</p>
      </div>` : ''}

      ${biggestExpense ? `
      <div class="recap-section">
        <div class="recap-kicker">Biggest Single Expense</div>
        <div class="recap-big mono">${fmtMoney(biggestExpense.amount)}</div>
        <p class="recap-sub">"${escapeHtml(biggestExpense.description)}" on ${fmtDateDisplay(biggestExpense.date)}.</p>
      </div>` : ''}

      ${bestMonth ? `
      <div class="recap-section">
        <div class="recap-kicker">Strongest Month</div>
        <div class="recap-big">${bestMonth.label}</div>
        <p class="recap-sub">netted you <b class="mono" style="color:${bestMonth.net>=0?'var(--income)':'var(--expense)'}">${fmtMoney(bestMonth.net)}</b> — your best of the last year.</p>
      </div>` : ''}

      <div class="recap-section">
        <div class="recap-kicker">Consistency</div>
        <div class="recap-big mono">${positiveMonths}<span style="font-size:22px; color:var(--ink-faint)">/${withData.length||1} months</span></div>
        <p class="recap-sub">you spent within what you earned.</p>
      </div>

      <div class="recap-section">
        <div class="recap-kicker">Financial Health Score</div>
        <div class="recap-big mono" style="color:${score>=60?'var(--income)':score>=30?'var(--warn)':'var(--expense)'}">${score}<span style="font-size:24px; color:var(--ink-faint)">/100</span></div>
        <p class="recap-sub">${score>=60?"A strong position — keep the habits that got you here.":score>=30?"A workable balance, with room to build a cushion.":"Worth a closer look at where the balance tips."}</p>
        <div class="recap-badge">${ICONS.sparkle} Here's to the next chapter of your ledger</div>
      </div>
    </div>
  `;

  document.getElementById('recap-close').addEventListener('click', closeRecap);
  overlay.classList.add('open');

  const incomeEl = document.getElementById('recap-income');
  if(incomeEl) setTimeout(()=> animateNumber(incomeEl, income, {decimals:2}), 300);

  const sections = overlay.querySelectorAll('.recap-section');
  if(reduceMotion || typeof IntersectionObserver === 'undefined'){
    sections.forEach(s=> s.classList.add('show'));
  } else {
    const io = new IntersectionObserver(entries=>{
      entries.forEach(e=>{ if(e.isIntersecting) e.target.classList.add('show'); });
    }, { threshold:0.35 });
    sections.forEach(s=> io.observe(s));
  }

  setTimeout(fireConfetti, 500);
}
function closeRecap(){
  const overlay = document.getElementById('recap-overlay');
  if(overlay) overlay.classList.remove('open');
}


