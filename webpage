/* ================================================================
   TRANSACTION DRAWER (add / edit)
   ================================================================ */
function openTxDrawer(presetType, editId){
  editingTxId = editId || null;
  const existing = editId ? state.transactions.find(t=>t.id===editId) : null;
  const type = existing ? existing.type : (presetType || 'Expense');
  const cats = type==='Income' ? INCOME_CATEGORIES : EXPENSE_CATEGORIES;

  let scrim = document.getElementById('drawer-scrim');
  if(!scrim){ scrim = document.createElement('div'); scrim.id='drawer-scrim'; scrim.className='scrim'; document.body.appendChild(scrim); }
  let drawer = document.getElementById('tx-drawer');
  if(!drawer){ drawer = document.createElement('div'); drawer.id='tx-drawer'; drawer.className='drawer'; document.body.appendChild(drawer); }

  drawer.innerHTML = `
    <div class="drawer-head">
      <h3>${existing ? 'Edit Entry' : 'New ' + type}</h3>
      <button class="icon-btn" id="drawer-close">${ICONS.x}</button>
    </div>
    <div class="drawer-body">
      ${!existing ? `
      <div class="toggle-group" id="type-toggle" style="align-self:flex-start">
        <button data-type="Income" class="${type==='Income'?'active':''}">Income</button>
        <button data-type="Expense" class="${type==='Expense'?'active':''}">Expense</button>
      </div>` : `<span class="pill ${existing.type==='Income'?'income':'expense'}">${existing.type}</span>`}

      <div class="field"><label>Date</label><input type="date" id="tx-date" value="${existing ? existing.date : todayISO()}"></div>

      ${state.accounts.length>1 ? `
      <div class="field">
        <label>Account</label>
        <select id="tx-account">
          ${state.accounts.map(a=>`<option value="${a.id}" ${(existing?existing.accountId:state.defaultAccountId)===a.id?'selected':''}>${escapeHtml(a.name)}</option>`).join('')}
        </select>
      </div>` : `<input type="hidden" id="tx-account" value="${state.defaultAccountId}">`}

      <div class="field">
        <label>Category</label>
        <select id="tx-category">
          ${cats.map(c=>`<option value="${c}" ${existing && existing.category===c ? 'selected':''}>${c}</option>`).join('')}
        </select>
      </div>

      <div class="field">
        <label>Amount</label>
        <input class="mono-input" id="tx-amount" type="number" step="0.01" min="0.01" placeholder="0.00" value="${existing ? existing.amount : ''}">
        <div class="hint" id="tx-amount-hint"></div>
      </div>

      <div class="field">
        <label>Description</label>
        <textarea id="tx-desc" rows="3" placeholder="What was this for?">${existing ? escapeHtml(existing.description) : ''}</textarea>
        <div class="hint" id="tx-desc-hint"></div>
      </div>

      <div class="card-index">ID ${existing ? existing.id : state.nextId} · logged ${existing ? existing.time : nowHM()} · ${type} entry, ${cats.length} categories available</div>
    </div>
    <div class="drawer-foot">
      <button class="btn btn-ghost" id="drawer-cancel">Cancel</button>
      <button class="btn ${type==='Income'?'btn-income':'btn-expense'}" id="drawer-save">${existing ? 'Save Changes' : 'Add ' + type}</button>
    </div>
  `;

  let currentType = type;
  const toggle = document.getElementById('type-toggle');
  if(toggle){
    toggle.querySelectorAll('button').forEach(b=>b.addEventListener('click', ()=>{
      currentType = b.dataset.type;
      toggle.querySelectorAll('button').forEach(x=>x.classList.toggle('active', x===b));
      const catSel = document.getElementById('tx-category');
      const newCats = currentType==='Income' ? INCOME_CATEGORIES : EXPENSE_CATEGORIES;
      catSel.innerHTML = newCats.map(c=>`<option value="${c}">${c}</option>`).join('');
      const saveBtn = document.getElementById('drawer-save');
      saveBtn.className = 'btn ' + (currentType==='Income' ? 'btn-income' : 'btn-expense');
      saveBtn.textContent = 'Add ' + currentType;
      document.querySelector('.drawer-head h3').textContent = 'New ' + currentType;
    }));
  }

  document.getElementById('drawer-close').addEventListener('click', closeTxDrawer);
  document.getElementById('drawer-cancel').addEventListener('click', closeTxDrawer);
  document.getElementById('drawer-save').addEventListener('click', ()=>saveTxFromDrawer(currentType, existing));

  requestAnimationFrame(()=>{ scrim.classList.add('open'); drawer.classList.add('open'); });
  scrim.onclick = closeTxDrawer;
}

function closeTxDrawer(){
  const scrim = document.getElementById('drawer-scrim');
  const drawer = document.getElementById('tx-drawer');
  if(scrim) scrim.classList.remove('open');
  if(drawer) drawer.classList.remove('open');
  editingTxId = null;
}

async function saveTxFromDrawer(type, existing){
  const dateEl = document.getElementById('tx-date');
  const catEl = document.getElementById('tx-category');
  const amtEl = document.getElementById('tx-amount');
  const descEl = document.getElementById('tx-desc');
  const acctEl = document.getElementById('tx-account');
  const amtHint = document.getElementById('tx-amount-hint');
  const descHint = document.getElementById('tx-desc-hint');

  let valid = true;
  const amount = parseFloat(amtEl.value);
  if(!amtEl.value || isNaN(amount) || amount <= 0){
    amtHint.textContent = 'Enter an amount greater than zero.';
    amtEl.closest('.field').classList.add('invalid');
    valid = false;
  } else {
    amtHint.textContent = ''; amtEl.closest('.field').classList.remove('invalid');
  }
  if(!descEl.value.trim()){
    descHint.textContent = "Description can't be empty.";
    descEl.closest('.field').classList.add('invalid');
    valid = false;
  } else {
    descHint.textContent = ''; descEl.closest('.field').classList.remove('invalid');
  }
  if(!dateEl.value){ valid = false; dateEl.closest('.field').classList.add('invalid'); }
  if(!valid) return;

  const accountId = Number(acctEl.value) || state.defaultAccountId;

  if(existing){
    existing.date = dateEl.value;
    existing.category = catEl.value;
    existing.amount = Math.round(amount*100)/100;
    existing.description = descEl.value.trim();
    existing.accountId = accountId;
    toast('Entry updated.', 'success');
  } else {
    const tx = {
      id: uid(), date: dateEl.value, time: nowHM(), type: type,
      category: catEl.value, amount: Math.round(amount*100)/100, description: descEl.value.trim(),
      accountId: accountId
    };
    state.transactions.push(tx);
    playStamp(type, type==='Income' ? 'Received' : 'Recorded', tx.amount);
  }
  await saveState();
  closeTxDrawer();
  renderShell(); renderView();
}

function confirmDelete(id){
  const tx = state.transactions.find(t=>t.id===id);
  if(!tx) return;
  showModal({
    title: 'Delete this entry?',
    body: `<b class="mono">${fmtMoney(tx.amount)}</b> · ${escapeHtml(tx.category)} on ${fmtDateDisplay(tx.date)}<br>"${escapeHtml(tx.description)}" will be permanently removed.`,
    confirmLabel: 'Delete', confirmClass: 'btn-danger',
    onConfirm: async ()=>{
      state.transactions = state.transactions.filter(t=>t.id!==id);
      await saveState();
      toast('Entry deleted.', 'success');
      renderShell(); renderView();
    }
  });
}

function showModal({title, body, confirmLabel, confirmClass, onConfirm, hideCancel}){
  let wrap = document.getElementById('modal-wrap');
  if(!wrap){ wrap = document.createElement('div'); wrap.id='modal-wrap'; wrap.className='modal-wrap'; document.body.appendChild(wrap); }
  wrap.innerHTML = `
    <div class="modal">
      <h3>${title}</h3>
      <p>${body}</p>
      <div class="modal-actions">
        ${hideCancel ? '' : '<button class="btn btn-ghost" id="modal-cancel">Cancel</button>'}
        <button class="btn ${confirmClass||'btn-primary'}" id="modal-confirm">${confirmLabel||'Confirm'}</button>
      </div>
    </div>`;
  const close = ()=> wrap.classList.remove('open');
  const cancelBtn = document.getElementById('modal-cancel');
  if(cancelBtn) cancelBtn.addEventListener('click', close);
  document.getElementById('modal-confirm').addEventListener('click', ()=>{ close(); onConfirm && onConfirm(); });
  requestAnimationFrame(()=> wrap.classList.add('open'));
}

