            const pct = expenseSum>0 ? (total/expenseSum*100) : 0;
            const maxTotal = expTotals[0][1];
            return `
            <div class="tally-row">
              <span class="cat-name">${escapeHtml(name)}</span>
              <div class="tally-track"><div class="tally-fill" data-target="${(total/maxTotal*100)}" style="background:${catColor(name)}"></div></div>
              <span class="tally-val">${fmtMoney(total)} <span style="color:var(--ink-faint)">· ${pct.toFixed(1)}%</span></span>
            </div>`;
          }).join('')}
        </div>
      </div>
      <div class="panel span-5">
        <div class="panel-head"><div><div class="eyebrow">Proportional</div><h3>Share of Spending</h3></div></div>
        <div class="panel-pad"><canvas id="chart-analytics-donut" height="230"></canvas></div>
      </div>
    </div>

    <div class="grid grid-12" style="margin-top:16px">
      <div class="panel span-6 panel-pad">
        <div class="eyebrow" style="margin-bottom:10px">Extremes</div>
        <div style="display:flex; flex-direction:column; gap:10px">
          <div class="kpi-row" style="justify-content:space-between"><span style="color:var(--ink-muted); font-size:13px">Highest spending category</span><span class="mono" style="color:var(--expense); font-weight:600">${maxCat?escapeHtml(maxCat[0]):'—'} · ${maxCat?fmtMoney(maxCat[1]):'—'}</span></div>
          <div class="kpi-row" style="justify-content:space-between"><span style="color:var(--ink-muted); font-size:13px">Lowest spending category</span><span class="mono" style="color:var(--ink); font-weight:600">${minCat?escapeHtml(minCat[0]):'—'} · ${minCat?fmtMoney(minCat[1]):'—'}</span></div>
        </div>
      </div>
      <div class="panel span-6">
        <div class="panel-head"><div><div class="eyebrow">Descriptive</div><h3>Financial Statistics</h3></div></div>
        <div class="panel-pad" style="display:grid; grid-template-columns:1fr 1fr; gap:14px 24px;">
          ${statLine('Transactions', tx.length, false)}
          ${statLine('Average transaction', avgTx, true)}
          ${statLine('Median expense', medExp, true)}
          ${statLine('Largest expense', expenseAmounts.length?Math.max(...expenseAmounts):0, true)}
          ${statLine('Smallest expense', expenseAmounts.length?Math.min(...expenseAmounts):0, true)}
          ${statLine('Largest income', incomeAmounts.length?Math.max(...incomeAmounts):0, true)}
          ${statLine('Smallest income', incomeAmounts.length?Math.min(...incomeAmounts):0, true)}
          ${statLine('Expense / income ratio', ratio.toFixed(1)+'%', false)}
        </div>
      </div>
    </div>

    <div class="panel" style="margin-top:16px">
      <div class="panel-head"><div><div class="eyebrow">Last ~18 weeks</div><h3>Spending Heatmap</h3></div></div>
