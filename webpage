<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ledger — Personal Finance Manager</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,380;9..144,480;9..144,600;9..144,680&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js" referrerpolicy="no-referrer"></script>
<style>
/* ============================================================
   DESIGN TOKENS
   A leather ledger book, brass instruments, engraved banknotes.
   Not a dashboard template — an accountant's desk at night.
   ============================================================ */
:root{
  --bg:            #0E1D18;
  --bg-panel:      #142A22;
  --bg-panel-2:    #1B362C;
  --bg-inset:      #0A1611;
  --line:          rgba(237,234,224,0.09);
  --line-strong:   rgba(237,234,224,0.18);
  --ink:           #EDEAE0;
  --ink-muted:     #9FB3A8;
  --ink-faint:     #66806F;
  --gold:          #C9A24B;
  --gold-bright:   #E4C067;
  --gold-dim:      rgba(201,162,75,0.14);
  --income:        #5FBE8A;
  --income-dim:    rgba(95,190,138,0.14);
  --expense:       #D9694C;
  --expense-dim:   rgba(217,105,76,0.14);
  --warn:          #E0B84B;

  --radius-sm: 5px;
  --radius-md: 9px;
  --radius-lg: 15px;
  --shadow-lift: 0 24px 60px -24px rgba(0,0,0,0.65);
  --shadow-soft: 0 8px 24px -12px rgba(0,0,0,0.5);

  --font-display: 'Fraunces', Georgia, 'Iowan Old Style', serif;
  --font-body: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  --font-mono: 'IBM Plex Mono', 'SFMono-Regular', Consolas, monospace;

  --dur-1: 140ms;
  --dur-2: 320ms;
  --dur-3: 620ms;
  --ease: cubic-bezier(.22,.68,.16,1);
}

@media (prefers-reduced-motion: reduce){
  *, *::before, *::after{ animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; scroll-behavior: auto !important; }
}

*{ box-sizing: border-box; }
html,body{ height:100%; }
body{
  margin:0;
  background:
    radial-gradient(ellipse 1200px 800px at 12% -10%, rgba(201,162,75,0.07), transparent 60%),
    radial-gradient(ellipse 900px 700px at 100% 0%, rgba(95,190,138,0.05), transparent 55%),
    var(--bg);
  color: var(--ink);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  font-size: 14px;
  line-height: 1.5;
}
h1,h2,h3,h4{ font-family: var(--font-display); font-weight: 600; margin: 0; letter-spacing: -0.01em; }
p{ margin:0; }
button{ font-family: inherit; }
a{ color: inherit; }
::selection{ background: var(--gold-dim); color: var(--gold-bright); }

.mono{ font-family: var(--font-mono); font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
.eyebrow{ text-transform: uppercase; letter-spacing: 0.14em; font-size: 10.5px; color: var(--ink-faint); font-weight: 600; }

/* Scrollbar, kept quiet */
::-webkit-scrollbar{ width: 10px; height: 10px; }
::-webkit-scrollbar-track{ background: transparent; }
::-webkit-scrollbar-thumb{ background: var(--line-strong); border-radius: 8px; border: 2px solid var(--bg); }

/* ============================================================
   SHELL LAYOUT
   ============================================================ */
.shell{
  display: grid;
  grid-template-columns: 232px 1fr;
  min-height: 100vh;
}

/* ---- Sidebar ---- */
.sidebar{
  background: linear-gradient(180deg, var(--bg-panel), var(--bg-inset));
  border-right: 1px solid var(--line);
  padding: 26px 18px;
  display: flex;
  flex-direction: column;
  position: sticky;
  top:0;
  height: 100vh;
}
.brand{ display:flex; align-items:center; gap:11px; padding: 4px 6px 26px; }
.brand-mark{
  width:36px; height:36px; border-radius: 9px;
  background: linear-gradient(150deg, var(--gold-bright), var(--gold) 60%, #8a6d2e);
  display:flex; align-items:center; justify-content:center;
  font-family: var(--font-display); font-weight:700; font-size:16px; color:#1a1408;
  box-shadow: 0 6px 16px -6px rgba(201,162,75,0.55), inset 0 1px 0 rgba(255,255,255,0.35);
  flex-shrink:0;
}
.brand-text h1{ font-size: 16.5px; color: var(--ink); line-height:1.1; }
.brand-text span{ display:block; font-size: 10px; color: var(--ink-faint); margin-top:3px; letter-spacing:0.05em; }

.nav{ display:flex; flex-direction:column; gap:2px; margin-top: 6px; }
.nav-item{
  display:flex; align-items:center; gap:11px;
  padding: 10px 12px; border-radius: var(--radius-md);
  color: var(--ink-muted); text-decoration:none; cursor:pointer;
  font-size: 13.4px; font-weight: 500;
  border: 1px solid transparent;
  background: transparent;
  transition: background var(--dur-1) var(--ease), color var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease);
  position: relative;
}
.nav-item svg{ width:16px; height:16px; flex-shrink:0; opacity:0.85; }
.nav-item:hover{ background: rgba(237,234,224,0.04); color: var(--ink); }
.nav-item.active{
  background: var(--gold-dim);
  color: var(--gold-bright);
  border-color: rgba(201,162,75,0.25);
}
.nav-item .kbd{ margin-left:auto; font-family: var(--font-mono); font-size:10px; color: var(--ink-faint); border:1px solid var(--line-strong); border-radius:4px; padding:1px 5px; }

.sidebar-foot{ margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); }
.clock{ font-family: var(--font-mono); font-size: 12px; color: var(--ink-muted); }
.clock .date{ color: var(--ink); font-weight:500; }

/* ---- Main ---- */
.main{ min-width:0; display:flex; flex-direction:column; }
.topbar{
  display:flex; align-items:center; justify-content:space-between;
  padding: 22px 34px 16px;
  gap: 20px;
  flex-wrap: wrap;
}
.topbar-title .eyebrow{ margin-bottom:4px; }
.topbar-title h2{ font-size: 24px; color: var(--ink); }
.topbar-actions{ display:flex; gap:10px; align-items:center; }

.view-root{ padding: 4px 34px 60px; flex:1; }

/* ============================================================
   BUTTONS
   ============================================================ */
.btn{
  display:inline-flex; align-items:center; gap:8px; justify-content:center;
  padding: 9px 16px; border-radius: var(--radius-md);
  font-size: 13px; font-weight: 600; cursor:pointer;
  border: 1px solid var(--line-strong);
  background: rgba(237,234,224,0.03);
  color: var(--ink);
  transition: transform var(--dur-1) var(--ease), background var(--dur-1) var(--ease), border-color var(--dur-1) var(--ease), box-shadow var(--dur-1) var(--ease);
  white-space: nowrap;
}
.btn svg{ width:14px; height:14px; }
.btn:hover{ background: rgba(237,234,224,0.07); border-color: rgba(237,234,224,0.28); }
.btn:active{ transform: translateY(1px) scale(0.98); }
.btn:focus-visible{ outline: 2px solid var(--gold-bright); outline-offset: 2px; }

.btn-primary{
  background: linear-gradient(155deg, var(--gold-bright), var(--gold));
  color: #1a1408; border-color: transparent;
  box-shadow: 0 10px 24px -10px rgba(201,162,75,0.55);
}
.btn-primary:hover{ filter: brightness(1.06); box-shadow: 0 12px 28px -8px rgba(201,162,75,0.7); }

.btn-income{ background: linear-gradient(155deg, #74d19f, var(--income)); color:#07231536; color:#0B2418; border-color:transparent; }
.btn-expense{ background: linear-gradient(155deg, #e58868, var(--expense)); color:#2b0f08; border-color:transparent; }
.btn-ghost{ background: transparent; border-color: transparent; color: var(--ink-muted); }
.btn-ghost:hover{ color: var(--ink); background: rgba(237,234,224,0.05); }
.btn-danger{ background: transparent; border-color: rgba(217,105,76,0.4); color: var(--expense); }
.btn-danger:hover{ background: var(--expense-dim); }
.btn-sm{ padding: 6px 11px; font-size: 12px; border-radius: var(--radius-sm); }
.btn-icon{ padding: 8px; border-radius: var(--radius-sm); }
.btn:disabled{ opacity:0.45; cursor:not-allowed; transform:none; box-shadow:none; }

/* ============================================================
   CARDS / PANELS
   ============================================================ */
.panel{
  background: linear-gradient(175deg, var(--bg-panel), var(--bg-panel-2) 130%);
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-soft);
}
.panel-pad{ padding: 22px 24px; }
.panel-head{ display:flex; align-items:center; justify-content:space-between; padding: 18px 22px; border-bottom: 1px solid var(--line); }
.panel-head h3{ font-size: 15px; color: var(--ink); }
.panel-head .eyebrow{ margin-bottom: 3px; }

.grid{ display:grid; gap: 16px; }
.grid-4{ grid-template-columns: repeat(4, 1fr); }
.grid-3{ grid-template-columns: repeat(3, 1fr); }
.grid-2{ grid-template-columns: repeat(2, 1fr); }
.grid-12{ grid-template-columns: repeat(12, 1fr); }
.span-7{ grid-column: span 7; }
.span-5{ grid-column: span 5; }
.span-8{ grid-column: span 8; }
.span-4{ grid-column: span 4; }
.span-6{ grid-column: span 6; }
.span-12{ grid-column: span 12; }

@media (max-width: 1180px){
  .grid-4{ grid-template-columns: repeat(2,1fr); }
  .span-7,.span-5,.span-8,.span-4,.span-6{ grid-column: span 12; }
}
@media (max-width: 640px){
  .grid-4,.grid-3,.grid-2{ grid-template-columns: 1fr; }
}

/* ============================================================
   HERO / STAT CARDS
   ============================================================ */
.hero{
  position: relative; overflow:hidden;
  padding: 30px 30px 26px;
}
.hero::before{
  content:''; position:absolute; inset:0; pointer-events:none;
  background: radial-gradient(560px 260px at 88% -10%, rgba(201,162,75,0.16), transparent 65%);
}
.hero-eyebrow{ display:flex; align-items:center; gap:10px; margin-bottom: 10px; }
.hero-figure{ font-family: var(--font-display); font-weight: 600; font-size: 58px; line-height:1; display:flex; align-items:baseline; gap:10px; }
.hero-figure .sign{ font-size: 32px; opacity:0.7; }
.hero-figure .unit{ font-family: var(--font-mono); font-size: 15px; color: var(--ink-faint); font-weight:500; margin-left:4px;}
.hero-sub{ margin-top:10px; color: var(--ink-muted); font-size: 13px; }
.hero-sub b{ color: var(--ink); font-weight:600; }
.hero-sparkline{ position:absolute; right:26px; bottom:0; width: 46%; height: 92px; opacity:0.9; }

.stat-card{ padding: 18px 20px; display:flex; flex-direction:column; gap: 10px; }
.stat-card .stat-top{ display:flex; align-items:center; justify-content:space-between; }
.stat-card .stat-icon{ width:30px;height:30px;border-radius:8px; display:flex; align-items:center; justify-content:center; }
.stat-card .stat-icon svg{ width:15px; height:15px; }
.stat-card .stat-val{ font-family: var(--font-mono); font-size: 24px; font-weight:600; letter-spacing:-0.02em; }
.stat-card .stat-delta{ font-size: 11.5px; font-weight:600; display:inline-flex; align-items:center; gap:4px; width:fit-content; padding: 2px 8px; border-radius: 20px; }
.delta-up{ color: var(--income); background: var(--income-dim); }
.delta-down{ color: var(--expense); background: var(--expense-dim); }
.delta-flat{ color: var(--ink-faint); background: rgba(237,234,224,0.05); }

/* ============================================================
   LEDGER TABLE
   ============================================================ */
.ledger-table{ width:100%; border-collapse: collapse; }
.ledger-table thead th{
  text-align:left; font-size: 10.5px; text-transform:uppercase; letter-spacing:0.08em;
  color: var(--ink-faint); font-weight:600; padding: 12px 10px; border-bottom: 1px solid var(--line-strong);
  position: sticky; top:0; background: var(--bg-panel); z-index:2;
}
.month-row td{
  padding: 14px 10px 8px; font-family: var(--font-display); font-size: 13px; color: var(--gold-bright);
  border-bottom: 1px dashed var(--line);
}
.ledger-table tbody tr.tx-row{
  border-bottom: 1px solid var(--line);
  transition: background var(--dur-1) var(--ease);
}
.ledger-table tbody tr.tx-row:hover{ background: rgba(237,234,224,0.025); }
.ledger-table td{ padding: 11px 10px; vertical-align: middle; font-size: 13px; }
.tx-row.tx-enter{ animation: rowIn var(--dur-3) var(--ease); }
@keyframes rowIn{ from{ opacity:0; transform: translateY(-6px); background: var(--gold-dim);} to{ opacity:1; transform:none; } }

.badge{
  display:inline-flex; align-items:center; gap:6px; padding: 3px 9px 3px 7px; border-radius: 20px;
  font-size: 11px; font-weight:600; white-space:nowrap;
}
.badge .dot{ width:6px; height:6px; border-radius:50%; }
.badge-income{ color: var(--income); background: var(--income-dim); }
.badge-expense{ color: var(--expense); background: var(--expense-dim); }
.cat-chip{ display:inline-flex; align-items:center; gap:6px; font-size:12px; color: var(--ink-muted); }
.cat-chip .dot{ width:7px; height:7px; border-radius:50%; flex-shrink:0; }

.amount-cell{ text-align:right; font-family: var(--font-mono); font-weight:600; font-size:13.5px; }
.amount-income{ color: var(--income); }
.amount-expense{ color: var(--expense); }
.desc-cell{ color: var(--ink-muted); max-width: 260px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.row-actions{ display:flex; gap:4px; justify-content:flex-end; opacity:0; transition: opacity var(--dur-1) var(--ease); }
.tx-row:hover .row-actions{ opacity:1; }
.icon-btn{
  width:26px;height:26px; border-radius:6px; display:flex; align-items:center; justify-content:center;
  border:1px solid transparent; background:transparent; color: var(--ink-faint); cursor:pointer;
}
.icon-btn:hover{ background: rgba(237,234,224,0.07); color: var(--ink); }
.icon-btn.danger:hover{ background: var(--expense-dim); color: var(--expense); }
.icon-btn svg{ width:13px;height:13px; }

/* ============================================================
   FORMS
   ============================================================ */
.field{ display:flex; flex-direction:column; gap:6px; }
.field label{ font-size:11.5px; color: var(--ink-faint); font-weight:600; text-transform:uppercase; letter-spacing:0.05em; }
.field .hint{ font-size:11px; color: var(--expense); min-height:1px; }
input, select, textarea{
  font-family: var(--font-body); font-size: 13.5px; color: var(--ink);
  background: var(--bg-inset); border: 1px solid var(--line-strong); border-radius: var(--radius-sm);
  padding: 10px 12px; outline:none; width:100%;
  transition: border-color var(--dur-1) var(--ease), box-shadow var(--dur-1) var(--ease);
}
input.mono-input, select.mono-input{ font-family: var(--font-mono); }
input:focus, select:focus, textarea:focus{ border-color: var(--gold); box-shadow: 0 0 0 3px var(--gold-dim); }
input[type=date]{ color-scheme: dark; }
.field.invalid input, .field.invalid select{ border-color: var(--expense); box-shadow: 0 0 0 3px var(--expense-dim); }
::placeholder{ color: var(--ink-faint); }

.search-wrap{ position:relative; }
.search-wrap svg{ position:absolute; left:11px; top:50%; transform:translateY(-50%); width:14px;height:14px; color:var(--ink-faint); }
.search-wrap input{ padding-left:32px; }

.toggle-group{ display:inline-flex; background: var(--bg-inset); border:1px solid var(--line-strong); border-radius: var(--radius-md); padding:3px; gap:3px; }
.toggle-group button{
  border:none; background:transparent; color: var(--ink-muted); font-size:12.5px; font-weight:600;
  padding: 7px 14px; border-radius: 7px; cursor:pointer; transition: all var(--dur-1) var(--ease);
}
.toggle-group button.active{ background: var(--gold-dim); color: var(--gold-bright); }

/* ============================================================
   DRAWER + MODAL
   ============================================================ */
.scrim{
  position:fixed; inset:0; background: rgba(6,12,9,0.6); backdrop-filter: blur(3px);
  opacity:0; pointer-events:none; transition: opacity var(--dur-2) var(--ease); z-index:40;
}
.scrim.open{ opacity:1; pointer-events:auto; }

.drawer{
  position:fixed; top:0; right:0; height:100vh; width: 420px; max-width:92vw;
  background: linear-gradient(180deg, var(--bg-panel-2), var(--bg-panel));
  border-left: 1px solid var(--line-strong);
  box-shadow: var(--shadow-lift);
  transform: translateX(100%);
  transition: transform var(--dur-3) var(--ease);
  z-index:41; display:flex; flex-direction:column;
}
.drawer.open{ transform: translateX(0); }
.drawer-head{ padding: 22px 24px 16px; border-bottom:1px solid var(--line); display:flex; align-items:center; justify-content:space-between; }
.drawer-head h3{ font-size:18px; }
.drawer-body{ padding: 20px 24px; overflow-y:auto; flex:1; display:flex; flex-direction:column; gap:16px; }
.drawer-foot{ padding: 16px 24px 22px; border-top:1px solid var(--line); display:flex; gap:10px; }
.drawer-foot .btn{ flex:1; }

.card-index{
  border: 1.5px dashed var(--line-strong); border-radius: var(--radius-md);
  padding: 14px 16px; background: repeating-linear-gradient(var(--bg-inset), var(--bg-inset) 27px, rgba(237,234,224,0.035) 28px);
  font-family: var(--font-mono); font-size: 12px; color: var(--ink-faint);
}

.modal-wrap{ position:fixed; inset:0; display:flex; align-items:center; justify-content:center; z-index:50; pointer-events:none; }
.modal{
  background: var(--bg-panel-2); border:1px solid var(--line-strong); border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lift); width: 380px; max-width: 90vw; padding: 24px;
  transform: scale(0.94) translateY(6px); opacity:0; transition: all var(--dur-2) var(--ease); pointer-events:auto;
}
.modal-wrap.open .modal{ transform:none; opacity:1; }
.modal h3{ font-size:16px; margin-bottom:8px; }
.modal p{ color: var(--ink-muted); font-size:13px; line-height:1.6; }
.modal-actions{ display:flex; gap:10px; margin-top:20px; }
.modal-actions .btn{ flex:1; }

/* ============================================================
   STAMP CONFIRMATION (signature moment)
   ============================================================ */
.stamp-layer{ position:fixed; inset:0; pointer-events:none; z-index:60; display:flex; align-items:center; justify-content:center; }
.stamp{
  font-family: var(--font-display); font-weight:700; font-size: 30px; letter-spacing: 0.06em;
  color: var(--expense); border: 4px solid var(--expense); border-radius: 10px; padding: 10px 26px;
  text-transform: uppercase; opacity:0; transform: scale(2.6) rotate(-14deg);
  mix-blend-mode: screen; filter: blur(0px);
}
.stamp.income{ color: var(--income); border-color: var(--income); }
.stamp.play{ animation: stampThud 720ms cubic-bezier(.2,.9,.25,1) forwards; }
@keyframes stampThud{
  0%{ opacity:0; transform: scale(2.6) rotate(-14deg); }
  55%{ opacity:1; transform: scale(0.96) rotate(-8deg); }
  70%{ transform: scale(1.05) rotate(-9deg); }
  100%{ opacity:0; transform: scale(1) rotate(-8deg); }
}

/* ============================================================
   TOAST
   ============================================================ */
.toast-stack{ position:fixed; bottom:22px; right:22px; display:flex; flex-direction:column; gap:8px; z-index:70; }
.toast{
  background: var(--bg-panel-2); border:1px solid var(--line-strong); border-left: 3px solid var(--gold);
  border-radius: var(--radius-sm); padding: 12px 16px; font-size:12.5px; color: var(--ink);
  box-shadow: var(--shadow-soft); min-width:220px;
  animation: toastIn var(--dur-2) var(--ease);
}
.toast.error{ border-left-color: var(--expense); }
.toast.success{ border-left-color: var(--income); }
@keyframes toastIn{ from{ opacity:0; transform: translateY(8px);} to{opacity:1; transform:none;} }

/* ============================================================
   GAUGE (budget)
   ============================================================ */
.gauge-wrap{ display:flex; flex-direction:column; align-items:center; gap:6px; padding: 10px 0 4px; }
.gauge-value{ font-family: var(--font-mono); font-size: 30px; font-weight:600; margin-top:-58px; }
.gauge-label{ font-size:11.5px; color: var(--ink-faint); text-transform:uppercase; letter-spacing:0.08em; }

/* ============================================================
   BAR / TALLY (category analysis)
   ============================================================ */
.tally-row{ display:grid; grid-template-columns: 118px 1fr 96px; align-items:center; gap:12px; padding: 8px 0; }
.tally-row .cat-name{ font-size:12.5px; color: var(--ink-muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.tally-track{ height: 9px; border-radius:5px; background: var(--bg-inset); overflow:hidden; border:1px solid var(--line); }
.tally-fill{ height:100%; border-radius:5px; width:0%; transition: width 900ms var(--ease); }
.tally-val{ font-family: var(--font-mono); font-size:12px; text-align:right; color: var(--ink-muted); }

/* ============================================================
   EMPTY STATES
   ============================================================ */
.empty{ text-align:center; padding: 64px 20px; color: var(--ink-faint); }
.empty svg{ width:38px;height:38px; margin-bottom:14px; opacity:0.5; }
.empty h4{ color: var(--ink-muted); font-size:15px; margin-bottom:6px; }
.empty p{ font-size:12.5px; max-width:320px; margin:0 auto; }

/* ============================================================
   MISC
   ============================================================ */
.divider{ height:1px; background: var(--line); border:none; margin: 4px 0; }
.kpi-row{ display:flex; gap:20px; flex-wrap:wrap; }
.pill{ padding:3px 10px; border-radius:20px; font-size:11px; font-weight:600; background: rgba(237,234,224,0.06); color: var(--ink-muted); }
.pill.gold{ background: var(--gold-dim); color: var(--gold-bright); }
.pill.income{ background: var(--income-dim); color: var(--income); }
.pill.expense{ background: var(--expense-dim); color: var(--expense); }
.statement{ font-family: var(--font-mono); font-size:12.5px; line-height:2; color: var(--ink-muted); white-space:pre-wrap; }
.statement b{ color: var(--ink); }
.health-score{ font-family: var(--font-display); font-size:44px; font-weight:600; }

.skeleton{ background: linear-gradient(90deg, var(--bg-panel), var(--bg-panel-2), var(--bg-panel)); background-size:200% 100%; animation: shimmer 1.4s infinite; border-radius:8px; }
@keyframes shimmer{ 0%{background-position:200% 0;} 100%{background-position:-200% 0;} }

@media print{
  .sidebar, .topbar, .no-print{ display:none !important; }
  body{ background: #fff; color:#111; }
  .view-root{ padding:0; }
  .panel{ border:1px solid #ccc; box-shadow:none; background:#fff; color:#111; }
  .statement{ color:#111; }
}

@media (max-width: 900px){
  .shell{ grid-template-columns: 1fr; }
  .sidebar{ position: fixed; bottom:0; left:0; right:0; top:auto; height:auto; width:100%;
    flex-direction:row; align-items:center; padding: 8px 10px; border-right:none; border-top:1px solid var(--line); z-index:30; }
  .brand, .sidebar-foot{ display:none; }
  .nav{ flex-direction:row; overflow-x:auto; width:100%; gap:2px; }
  .nav-item{ flex-direction:column; gap:3px; font-size:9.5px; padding:8px 10px; }
  .nav-item .kbd{ display:none; }
  .main{ padding-bottom: 70px; }
  .view-root{ padding: 4px 16px 40px; }
  .topbar{ padding: 18px 16px 12px; }
}
</style>
</head>
<body>
<div class="shell" id="shell">
  <!-- sidebar injected by JS -->
  <nav class="sidebar" id="sidebar"></nav>
  <div class="main">
    <header class="topbar" id="topbar"></header>
    <main class="view-root" id="view-root"></main>
  </div>
</div>

<div class="toast-stack" id="toast-stack"></div>
<div class="stamp-layer" id="stamp-layer"></div>

<script>
'use strict';

/* ================================================================
   CONSTANTS
   ================================================================ */
const STORAGE_KEY = 'pfm_state_v1';
const BACKUP_KEY  = 'pfm_backup_v1';

const INCOME_CATEGORIES = ['Salary','Freelancing','Business','Investment','Scholarship','Gift','Other'];
const EXPENSE_CATEGORIES = ['Food','Transport','Fuel','College','Shopping','Entertainment','Medical','Rent','Utilities','Travel','Insurance','Bills','Other'];

const CATEGORY_COLORS = {
  Salary:'#C9A24B', Freelancing:'#5C8FB0', Business:'#B27FB0', Investment:'#5FBE8A',
  Scholarship:'#6FA88A', Gift:'#D6B24A', Food:'#D9694C', Transport:'#5C8FB0',
  Fuel:'#C6673F', College:'#8AA6C9', Shopping:'#B27FB0', Entertainment:'#D6B24A',
  Medical:'#6FA88A', Rent:'#A98F4A', Utilities:'#7FB0A0', Travel:'#9E7FB0',
  Insurance:'#4A8C97', Bills:'#C98A4B', Other:'#7C8B84'
};
function catColor(name){ return CATEGORY_COLORS[name] || '#7C8B84'; }

const ICONS = {
  dashboard:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>',
  ledger:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16v16H4z"/><path d="M4 9h16M9 9v11"/></svg>',
  analytics:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20V10M11 20V4M18 20v-7"/></svg>',
  budget:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="13" r="8"/><path d="M12 13l3.5-3.5M8 3h8"/></svg>',
  goals:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>',
  reports:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3h8l4 4v14H7z"/><path d="M15 3v4h4M9 13h6M9 17h6"/></svg>',
  settings:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 00.34 1.87l.06.06a2 2 0 11-2.83 2.83l-.06-.06a1.7 1.7 0 00-1.87-.34 1.7 1.7 0 00-1 1.55V21a2 2 0 11-4 0v-.09a1.7 1.7 0 00-1-1.55 1.7 1.7 0 00-1.87.34l-.06.06a2 2 0 11-2.83-2.83l.06-.06a1.7 1.7 0 00.34-1.87 1.7 1.7 0 00-1.55-1H3a2 2 0 110-4h.09a1.7 1.7 0 001.55-1 1.7 1.7 0 00-.34-1.87l-.06-.06a2 2 0 112.83-2.83l.06.06a1.7 1.7 0 001.87.34H9a1.7 1.7 0 001-1.55V3a2 2 0 114 0v.09a1.7 1.7 0 001 1.55 1.7 1.7 0 001.87-.34l.06-.06a2 2 0 112.83 2.83l-.06.06a1.7 1.7 0 00-.34 1.87V9a1.7 1.7 0 001.55 1H21a2 2 0 110 4h-.09a1.7 1.7 0 00-1.55 1z"/></svg>',
  plus:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>',
  search:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>',
  edit:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"/></svg>',
  trash:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg>',
  income:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M5 12l7-7 7 7"/></svg>',
  expense:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>',
  target:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>',
  archive:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 5h18v4H3zM5 9v10h14V9M10 13h4"/></svg>',
  x:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>',
  empty:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16v16H4z"/><path d="M4 9h16M9 4v16" stroke-dasharray="2 3"/></svg>',
  down:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 4v13M6 12l6 6 6-6"/></svg>',
  print:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 9V3h12v6M6 18h12v4H6zM4 9h16v7H4z"/></svg>',
};

const NAV = [
  {id:'dashboard', label:'Dashboard', icon:'dashboard', key:'D'},
  {id:'ledger',    label:'Ledger',    icon:'ledger',    key:'L'},
  {id:'analytics', label:'Analytics', icon:'analytics', key:'A'},
  {id:'budget',    label:'Budget',    icon:'budget',    key:'B'},
  {id:'goals',     label:'Goals',     icon:'goals',     key:'G'},
  {id:'reports',   label:'Reports',   icon:'reports',   key:'R'},
  {id:'settings',  label:'Settings',  icon:'settings',  key:'S'},
];

/* ================================================================
   STATE
   ================================================================ */
let state = {
  transactions: [],
  nextId: 1001,
  monthlyBudget: 0,
  currency: '$',
  lastBackupAt: null,
};
let view = 'dashboard';
let ledgerFilters = { keyword:'', type:'all', category:'all', from:'', to:'', min:'', max:'' };
let editingTxId = null;
let charts = {};
let dataReady = false;

const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ================================================================
   PERSISTENCE
   ================================================================ */
async function loadState(){
  try{
    const result = await window.storage.get(STORAGE_KEY, false);
    if(result && result.value){
      const parsed = JSON.parse(result.value);
      state = Object.assign(state, parsed);
    }
  }catch(err){
    console.warn('No saved ledger yet, starting fresh.', err);
  }
  dataReady = true;
}

async function saveState(){
  try{
    const result = await window.storage.set(STORAGE_KEY, JSON.stringify(state), false);
    if(!result) toast('Could not save — your last change may not persist.', 'error');
  }catch(err){
    console.error(err);
    toast('Storage error while saving.', 'error');
  }
}

async function backupNow(){
  try{
    state.lastBackupAt = new Date().toISOString();
    const ok = await window.storage.set(BACKUP_KEY, JSON.stringify(state), false);
    await saveState();
    if(ok) toast('Backup created.', 'success'); else toast('Backup failed.', 'error');
    renderView();
  }catch(err){ toast('Backup failed.', 'error'); }
}

async function restoreFromBackup(){
  try{
    const result = await window.storage.get(BACKUP_KEY, false);
    if(!result || !result.value){ toast('No backup found yet.', 'error'); return; }
    const parsed = JSON.parse(result.value);
    state = Object.assign(state, parsed);
    await saveState();
    toast('Restored from backup.', 'success');
    renderShell(); renderView();
  }catch(err){ toast('No backup found yet.', 'error'); }
}

/* ================================================================
   UTILITIES
   ================================================================ */
function uid(){ return state.nextId++; }
function todayISO(){ const d = new Date(); return d.toISOString().slice(0,10); }
function nowHM(){ const d = new Date(); return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0'); }
function escapeHtml(s){ return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function fmtMoney(n){
  const neg = n < 0;
  const v = Math.abs(n).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
  return (neg?'−':'') + state.currency + v;
}
function fmtDateDisplay(iso){
  if(!iso) return '—';
  const [y,m,d] = iso.split('-');
  return `${d}-${m}-${y}`;
}
function monthLabel(iso){
  const d = new Date(iso+'T00:00:00');
  return d.toLocaleString(undefined, {month:'long', year:'numeric'});
}
function debounce(fn, ms){ let t; return (...a)=>{ clearTimeout(t); t=setTimeout(()=>fn(...a), ms); }; }

function toast(msg, kind){
  const stack = document.getElementById('toast-stack');
  const el = document.createElement('div');
  el.className = 'toast' + (kind ? ' '+kind : '');
  el.textContent = msg;
  stack.appendChild(el);
  setTimeout(()=>{ el.style.transition='opacity 300ms ease'; el.style.opacity='0'; setTimeout(()=>el.remove(), 320); }, 2600);
}

function playStamp(kind, label){
  if(reduceMotion){ toast(label + ' recorded.', 'success'); return; }
  const layer = document.getElementById('stamp-layer');
  const el = document.createElement('div');
  el.className = 'stamp ' + (kind==='Income' ? 'income' : '');
  el.textContent = label;
  layer.appendChild(el);
  requestAnimationFrame(()=> el.classList.add('play'));
  setTimeout(()=> el.remove(), 800);
}

function animateNumber(el, to, opts={}){
  const prefix = opts.prefix || '';
  const decimals = opts.decimals ?? 2;
  if(reduceMotion){ el.textContent = prefix + to.toLocaleString(undefined,{minimumFractionDigits:decimals,maximumFractionDigits:decimals}); return; }
  const from = 0;
  const dur = 900;
  const start = performance.now();
  function frame(now){
    const p = Math.min(1, (now-start)/dur);
    const eased = 1 - Math.pow(1-p, 3);
    const val = from + (to-from)*eased;
    el.textContent = prefix + val.toLocaleString(undefined,{minimumFractionDigits:decimals,maximumFractionDigits:decimals});
    if(p<1) requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
}

/* ================================================================
   DATA HELPERS
   ================================================================ */
function totalIncome(list){ return list.filter(t=>t.type==='Income').reduce((s,t)=>s+t.amount,0); }
function totalExpense(list){ return list.filter(t=>t.type==='Expense').reduce((s,t)=>s+t.amount,0); }

function sortedTx(){
  return [...state.transactions].sort((a,b)=>{
    if(a.date !== b.date) return a.date < b.date ? 1 : -1;
    return a.time < b.time ? 1 : (a.time > b.time ? -1 : 0);
  });
}

function categoryTotals(type){
  const map = {};
  state.transactions.filter(t=>t.type===type).forEach(t=>{
    map[t.category] = (map[t.category]||0) + t.amount;
  });
  return Object.entries(map).sort((a,b)=>b[1]-a[1]);
}

function lastNMonths(n){
  const out = [];
  const d = new Date();
  d.setDate(1);
  for(let i=n-1;i>=0;i--){
    const dt = new Date(d.getFullYear(), d.getMonth()-i, 1);
    out.push({ key: dt.getFullYear()+'-'+String(dt.getMonth()+1).padStart(2,'0'), label: dt.toLocaleString(undefined,{month:'short'}) });
  }
  return out;
}

function monthlySeries(months){
  return months.map(m=>{
    const inMonth = state.transactions.filter(t=>t.date.startsWith(m.key));
    return { label:m.label, income: totalIncome(inMonth), expense: totalExpense(inMonth) };
  });
}

function median(nums){
  if(nums.length===0) return 0;
  const s=[...nums].sort((a,b)=>a-b);
  const mid=Math.floor(s.length/2);
  return s.length%2 ? s[mid] : (s[mid-1]+s[mid])/2;
}

function healthScore(income, expense){
  if(income<=0) return 0;
  let score = Math.round(((income-expense)/income)*100);
  return Math.max(0, Math.min(100, score));
}

function motivationalMessage(positive){
  const good = ["Great! You're saving more than you spend.", "Steady hand on the ledger — keep it up.", "Your savings rate is healthy this month.", "Discipline is compounding in your favor."];
  const caution = ["Expenses are creeping past income — worth a look.", "Consider trimming discretionary categories.", "Your margin is thin this month — review the ledger.", "A tighter budget could help rebalance things."];
  const arr = positive ? good : caution;
  return arr[Math.floor(Math.random()*arr.length)];
}

/* ================================================================
   SHELL: sidebar + topbar
   ================================================================ */
function renderShell(){
  const sidebar = document.getElementById('sidebar');
  sidebar.innerHTML = `
    <div class="brand">
      <div class="brand-mark">£</div>
      <div class="brand-text"><h1>Ledger</h1><span>PERSONAL FINANCE</span></div>
    </div>
    <div class="nav">
      ${NAV.map(n=>`
        <div class="nav-item ${view===n.id?'active':''}" data-nav="${n.id}">
          ${ICONS[n.icon]}<span>${n.label}</span><span class="kbd">${n.key}</span>
        </div>`).join('')}
    </div>
    <div class="sidebar-foot">
      <div class="clock"><span class="date" id="clock-date"></span><br><span id="clock-time"></span></div>
    </div>
  `;
  sidebar.querySelectorAll('[data-nav]').forEach(el=>{
    el.addEventListener('click', ()=>{ view = el.dataset.nav; renderShell(); renderView(); });
  });
  updateClock();

  const topbar = document.getElementById('topbar');
  const titles = {
    dashboard:['OVERVIEW','Dashboard'], ledger:['ALL RECORDS','Ledger'], analytics:['BREAKDOWN','Analytics'],
    budget:['MONTHLY LIMIT','Budget'], goals:['PLAN AHEAD','Savings Goal'], reports:['STATEMENT','Reports'], settings:['DATA & PREFS','Settings']
  };
  const [eyebrow, title] = titles[view];
  topbar.innerHTML = `
    <div class="topbar-title"><div class="eyebrow">${eyebrow}</div><h2>${title}</h2></div>
    <div class="topbar-actions">
      <button class="btn btn-income" id="btn-add-income">${ICONS.plus} Add Income</button>
      <button class="btn btn-expense" id="btn-add-expense">${ICONS.plus} Add Expense</button>
    </div>
  `;
  document.getElementById('btn-add-income').addEventListener('click', ()=>openTxDrawer('Income'));
  document.getElementById('btn-add-expense').addEventListener('click', ()=>openTxDrawer('Expense'));
}

function updateClock(){
  const d = new Date();
  const dateEl = document.getElementById('clock-date');
  const timeEl = document.getElementById('clock-time');
  if(dateEl) dateEl.textContent = d.toLocaleDateString(undefined, {weekday:'short', day:'2-digit', month:'short', year:'numeric'});
  if(timeEl) timeEl.textContent = d.toLocaleTimeString(undefined, {hour:'2-digit', minute:'2-digit'});
}
setInterval(updateClock, 30000);

/* ================================================================
   VIEW ROUTER
   ================================================================ */
function renderView(){
  const root = document.getElementById('view-root');
  if(!dataReady){ root.innerHTML = skeletonHtml(); return; }
  Object.values(charts).forEach(c=>{ try{ c.destroy(); }catch(e){} });
  charts = {};
  const renderers = { dashboard:renderDashboard, ledger:renderLedger, analytics:renderAnalytics, budget:renderBudget, goals:renderGoals, reports:renderReports, settings:renderSettings };
  root.innerHTML = renderers[view]();
  afterRender[view] && afterRender[view]();
}
const afterRender = {};

function skeletonHtml(){
  return `<div class="grid grid-4" style="margin-top:10px">${'<div class="panel skeleton" style="height:110px"></div>'.repeat(4)}</div>`;
}

/* ================================================================
   VIEW: DASHBOARD
   ================================================================ */
function renderDashboard(){
  const tx = state.transactions;
  const income = totalIncome(tx);
  const expense = totalExpense(tx);
  const net = income - expense;
  const savingsRate = income>0 ? ((income-expense)/income*100) : 0;

  const months = lastNMonths(6);
  const series = monthlySeries(months);
  const thisMonthKey = months[months.length-1].key;
  const lastMonthKey = months[months.length-2] ? months[months.length-2].key : null;
  const thisMonthExpense = series[series.length-1].expense;
  const lastMonthExpense = lastMonthKey ? series[series.length-2].expense : 0;
  const expenseDelta = lastMonthExpense>0 ? ((thisMonthExpense-lastMonthExpense)/lastMonthExpense*100) : 0;

  if(tx.length===0){
    return `
      <div class="panel hero" style="margin-top:14px">
        <div class="empty" style="padding:70px 20px">
          ${ICONS.empty}
          <h4>The ledger is empty</h4>
          <p>Record your first income or expense with the buttons above — everything here fills in the moment you do.</p>
        </div>
      </div>`;
  }

  const recent = sortedTx().slice(0,5);

  return `
    <div class="panel hero" style="margin-top:14px">
      <div class="hero-eyebrow"><span class="eyebrow">Net position · all time</span></div>
      <div class="hero-figure mono">
        <span class="sign">${net>=0?'+':'−'}</span>${state.currency}<span id="hero-count">0.00</span>
      </div>
      <p class="hero-sub">Income <b class="mono">${fmtMoney(income)}</b> minus expense <b class="mono">${fmtMoney(expense)}</b> across <b>${tx.length}</b> recorded ${tx.length===1?'entry':'entries'}.</p>
      <svg class="hero-sparkline" viewBox="0 0 300 92" preserveAspectRatio="none">
        <polyline fill="none" stroke="${net>=0?'#5FBE8A':'#D9694C'}" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"
          points="${sparkPoints(series)}" opacity="0.85"/>
      </svg>
    </div>

    <div class="grid grid-4" style="margin-top:16px">
      ${statCard('Total Income', income, 'income', ICONS.income, null)}
      ${statCard('Total Expense', expense, 'expense', ICONS.expense, expenseDelta)}
      ${statCard('Savings Rate', savingsRate, 'rate', ICONS.target, null, '%')}
      ${budgetMiniCard()}
    </div>

    <div class="grid grid-12" style="margin-top:16px">
      <div class="panel span-7">
        <div class="panel-head"><div><div class="eyebrow">Last 6 months</div><h3>Income vs. Expense</h3></div></div>
        <div class="panel-pad"><canvas id="chart-trend" height="220"></canvas></div>
      </div>
      <div class="panel span-5">
        <div class="panel-head"><div><div class="eyebrow">This period</div><h3>Spending by category</h3></div></div>
        <div class="panel-pad"><canvas id="chart-donut" height="220"></canvas></div>
      </div>
    </div>

    <div class="panel" style="margin-top:16px">
      <div class="panel-head">
        <div><div class="eyebrow">Latest</div><h3>Recent entries</h3></div>
        <button class="btn btn-ghost btn-sm" data-goto="ledger">View full ledger →</button>
      </div>
      <table class="ledger-table"><tbody>
        ${recent.map(t=>txRow(t,false)).join('')}
      </tbody></table>
    </div>

    <div class="panel panel-pad" style="margin-top:16px; display:flex; gap:12px; align-items:center;">
      <div class="stat-icon" style="background:var(--gold-dim); color:var(--gold-bright); flex-shrink:0;">${ICONS.target}</div>
      <p style="color:var(--ink-muted); font-size:13px;">${motivationalMessage(net>=0)}</p>
    </div>
  `;
}

function sparkPoints(series){
  const vals = series.map(s=>s.income-s.expense);
  const min = Math.min(...vals, 0), max = Math.max(...vals, 1);
  const range = (max-min)||1;
  return vals.map((v,i)=>{
    const x = (i/(vals.length-1||1))*300;
    const y = 88 - ((v-min)/range)*80;
    return `${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(' ');
}

function statCard(label, value, kind, icon, delta, suffix){
  const colorVar = kind==='income' ? 'var(--income)' : kind==='expense' ? 'var(--expense)' : 'var(--gold-bright)';
  const bgVar = kind==='income' ? 'var(--income-dim)' : kind==='expense' ? 'var(--expense-dim)' : 'var(--gold-dim)';
  let deltaHtml = '';
  if(delta !== null && delta !== undefined && isFinite(delta)){
    const up = delta > 0.5, down = delta < -0.5;
    const cls = up ? 'delta-up' : down ? 'delta-down' : 'delta-flat';
    const arrow = up ? '↑' : down ? '↓' : '→';
    deltaHtml = `<span class="stat-delta ${cls}">${arrow} ${Math.abs(delta).toFixed(1)}% vs last mo.</span>`;
  }
  const displayVal = suffix==='%' ? value.toFixed(1)+'%' : fmtMoney(value);
  return `
    <div class="panel stat-card">
      <div class="stat-top">
        <span class="eyebrow">${label}</span>
        <div class="stat-icon" style="background:${bgVar}; color:${colorVar}">${icon}</div>
      </div>
      <div class="stat-val mono">${displayVal}</div>
      ${deltaHtml}
    </div>`;
}

function budgetMiniCard(){
  if(!state.monthlyBudget || state.monthlyBudget<=0){
    return `
      <div class="panel stat-card">
        <div class="stat-top"><span class="eyebrow">Budget</span><div class="stat-icon" style="background:var(--gold-dim); color:var(--gold-bright)">${ICONS.budget}</div></div>
        <div class="stat-val" style="font-size:13px; color:var(--ink-faint); font-family:var(--font-body); font-weight:500;">Not set yet</div>
        <button class="btn btn-ghost btn-sm" data-goto="budget" style="align-self:flex-start; padding-left:0;">Set a budget →</button>
      </div>`;
  }
  const expense = totalExpense(state.transactions.filter(t=>t.date.startsWith(todayISO().slice(0,7))));
  const frac = expense/state.monthlyBudget;
  const color = frac>=1 ? 'var(--expense)' : frac>=0.8 ? 'var(--warn)' : 'var(--income)';
  return `
    <div class="panel stat-card">
      <div class="stat-top"><span class="eyebrow">Budget this month</span><div class="stat-icon" style="background:var(--gold-dim); color:var(--gold-bright)">${ICONS.budget}</div></div>
      <div class="stat-val mono" style="color:${color}">${Math.round(frac*100)}%</div>
      <div class="tally-track"><div class="tally-fill" style="width:${Math.min(frac*100,100)}%; background:${color}"></div></div>
