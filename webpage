  const incomeSum = totalIncome(tx);
  const maxCat = expTotals[0];
  const minCat = expTotals[expTotals.length-1];

  const amounts = tx.map(t=>t.amount);
  const expenseAmounts = tx.filter(t=>t.type==='Expense').map(t=>t.amount);
  const incomeAmounts = tx.filter(t=>t.type==='Income').map(t=>t.amount);
  const avgTx = amounts.reduce((a,b)=>a+b,0)/amounts.length;
