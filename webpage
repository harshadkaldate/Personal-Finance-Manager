/* ================================================================
   SOUND LAYER
   Small, optional audio cues built on Tone.js. Every call is wrapped
   defensively: if the library failed to load (offline, blocked CDN)
   or the browser hasn't granted an audio context yet, these are
   silent no-ops rather than errors.
   ================================================================ */
let stampSynth = null, chimeSynth = null;

function unlockAudio(){
  if(audioUnlocked || typeof Tone === 'undefined') return;
  try{
    Tone.start();
    stampSynth = new Tone.MembraneSynth({ pitchDecay:0.02, octaves:3, envelope:{attack:0.001, decay:0.25, sustain:0} }).toDestination();
    stampSynth.volume.value = -10;
    chimeSynth = new Tone.PolySynth(Tone.Synth, { envelope:{attack:0.005, decay:0.3, sustain:0.15, release:0.6} }).toDestination();
    chimeSynth.volume.value = -12;
    audioUnlocked = true;
  }catch(err){ console.warn('Audio init skipped', err); }
}
document.addEventListener('pointerdown', unlockAudio, { once:true });
document.addEventListener('keydown', unlockAudio, { once:true });

function playSound(kind){
  if(!state.soundEnabled || !audioUnlocked || typeof Tone === 'undefined') return;
  try{
    if(kind==='stamp' && stampSynth){ stampSynth.triggerAttackRelease('C2', '8n'); }
    if(kind==='chime' && chimeSynth){
      const now = Tone.now();
      chimeSynth.triggerAttackRelease('C5', '16n', now);
      chimeSynth.triggerAttackRelease('E5', '16n', now+0.08);
      chimeSynth.triggerAttackRelease('G5', '16n', now+0.16);
      chimeSynth.triggerAttackRelease('C6', '8n', now+0.26);
    }
  }catch(err){ /* audio is a nicety, never let it break the app */ }
}

