   ============================================================ */
.sankey-node-label{ font-family: var(--font-mono); font-size: 10px; fill: var(--ink-muted); }
.sankey-node-label.strong{ fill: var(--ink); font-weight:600; }

/* ============================================================
   RECAP ("Year in Money")
   ============================================================ */
.recap-overlay{
  position:fixed; inset:0; z-index:80; overflow-y:auto;
  background: radial-gradient(ellipse 900px 600px at 50% 0%, rgba(201,162,75,0.1), transparent 60%), var(--bg);
  opacity:0; pointer-events:none; transition: opacity 420ms var(--ease);
}
.recap-overlay.open{ opacity:1; pointer-events:auto; }
.recap-close{ position:fixed; top:22px; right:26px; z-index:81; }
.recap-wrap{ max-width: 640px; margin: 0 auto; display:flex; flex-direction:column; gap:60px; padding: 90px 24px 100px; }
.recap-section{ text-align:center; opacity:0; transform: translateY(24px); transition: all 700ms var(--ease); }
.recap-section.show{ opacity:1; transform:none; }
.recap-kicker{ font-family: var(--font-mono); font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color: var(--gold); margin-bottom:14px; }
.recap-big{ font-family: var(--font-display); font-size: 52px; font-weight:600; line-height:1.05; }
.recap-big .mono{ font-family: var(--font-mono); }
.recap-sub{ margin-top:14px; color: var(--ink-muted); font-size:14.5px; line-height:1.7; max-width:460px; margin-left:auto; margin-right:auto; }
.recap-badge{ display:inline-flex; align-items:center; gap:8px; margin-top:18px; padding:8px 18px; border-radius:30px; background: var(--gold-dim); color: var(--gold-bright); font-weight:600; font-size:13px; }

/* ============================================================
   CONFETTI
   ============================================================ */
.confetti-layer{ position:fixed; inset:0; pointer-events:none; z-index:65; overflow:hidden; }
.confetti-piece{ position:absolute; top:-14px; border-radius:2px; animation: confettiFall linear forwards; }
@keyframes confettiFall{
  0%{ transform: translateY(0) rotate(0deg); opacity:1; }
  100%{ transform: translateY(108vh) rotate(720deg); opacity:0.4; }
}

/* ============================================================
