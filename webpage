}
.cmdk-wrap.open{ opacity:1; pointer-events:auto; }
.cmdk{
  width: 560px; max-width: 92vw; background: linear-gradient(175deg, var(--bg-panel-2), var(--bg-panel));
  border:1px solid var(--line-strong); border-radius: var(--radius-lg); box-shadow: var(--shadow-lift);
  transform: translateY(-14px) scale(0.98); transition: transform var(--dur-2) var(--ease); overflow:hidden;
}
