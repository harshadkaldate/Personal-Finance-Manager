          ${rules.map(r=>`
            <div class="recurring-row">
              <div class="rec-icon" style="background:${r.type==='Income'?'var(--income-dim)':'var(--expense-dim)'}; color:${r.type==='Income'?'var(--income)':'var(--expense)'}">${r.type==='Income'?ICONS.income:ICONS.expense}</div>
