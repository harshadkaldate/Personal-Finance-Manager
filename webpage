        </div>
      </div>
      <div class="panel span-6">
        <div class="panel-head"><div><div class="eyebrow">Descriptive</div><h3>Financial Statistics</h3></div></div>
        <div class="panel-pad" style="display:grid; grid-template-columns:1fr 1fr; gap:14px 24px;">
          ${statLine('Transactions', tx.length, false)}
          ${statLine('Average transaction', avgTx, true)}
          ${statLine('Median expense', medExp, true)}
          ${statLine('Largest expense', expenseAmounts.length?Math.max(...expenseAmounts):0, true)}
          ${statLine('Smallest expense', expenseAmounts.length?Math.min(...expenseAmounts):0, true)}
          ${statLine('Largest income', incomeAmounts.length?Math.max(...incomeAmounts):0, true)}
