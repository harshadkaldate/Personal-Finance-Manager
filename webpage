.cmdk-input-row input:focus{ box-shadow:none; }
.cmdk-hint{ font-size:10px; color: var(--ink-faint); border:1px solid var(--line-strong); padding:2px 6px; border-radius:5px; font-family: var(--font-mono); flex-shrink:0; }
.cmdk-body{ max-height: 360px; overflow-y:auto; padding: 8px; }
.cmdk-section-label{ font-size:10px; text-transform:uppercase; letter-spacing:0.08em; color: var(--ink-faint); padding: 10px 10px 4px; }
.cmdk-item{ display:flex; align-items:center; gap:11px; padding:10px 11px; border-radius: var(--radius-sm); cursor:pointer; color: var(--ink-muted); }
.cmdk-item svg{ width:15px; height:15px; opacity:0.8; }
.cmdk-item:hover, .cmdk-item.sel{ background: var(--gold-dim); color: var(--gold-bright); }
.cmdk-item .cmdk-sub{ margin-left:auto; font-size:11px; color: var(--ink-faint); font-family: var(--font-mono); }
.cmdk-preview{ margin: 6px 8px 12px; padding: 14px 16px; border-radius: var(--radius-md); border:1px dashed var(--line-strong); background: var(--bg-inset); }
.cmdk-preview .row{ display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
.cmdk-preview .amt{ font-family: var(--font-mono); font-size: 22px; font-weight:600; }
.cmdk-empty{ text-align:center; padding: 30px 10px; color: var(--ink-faint); font-size:12.5px; }

/* ============================================================
   ACCOUNTS
   ============================================================ */
.account-card{ padding: 18px 20px; display:flex; flex-direction:column; gap:12px; cursor:default; }
.account-card .acc-top{ display:flex; align-items:center; gap:10px; }
