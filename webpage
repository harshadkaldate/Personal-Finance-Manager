              <div class="tally-track"><div class="tally-fill" data-target="${(total/maxTotal*100)}" style="background:${catColor(name)}"></div></div>
              <span class="tally-val">${fmtMoney(total)} <span style="color:var(--ink-faint)">· ${pct.toFixed(1)}%</span></span>
