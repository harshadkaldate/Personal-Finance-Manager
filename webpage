      <div class="panel span-5">
        <div class="panel-head"><div><div class="eyebrow">Proportional</div><h3>Share of Spending</h3></div></div>
        <div class="panel-pad"><canvas id="chart-analytics-donut" height="230"></canvas></div>
      </div>
    </div>

    <div class="grid grid-12" style="margin-top:16px">
      <div class="panel span-6 panel-pad">
        <div class="eyebrow" style="margin-bottom:10px">Extremes</div>
        <div style="display:flex; flex-direction:column; gap:10px">
          <div class="kpi-row" style="justify-content:space-between"><span style="color:var(--ink-muted); font-size:13px">Highest spending category</span><span class="mono" style="color:var(--expense); font-weight:600">${maxCat?escapeHtml(maxCat[0]):'—'} · ${maxCat?fmtMoney(maxCat[1]):'—'}</span></div>
