afterRender.goals = function(){
  document.getElementById('goal-calc').addEventListener('click', ()=>{
    const target = parseFloat(document.getElementById('goal-target').value);
    const monthly = parseFloat(document.getElementById('goal-monthly').value);
    const resultEl = document.getElementById('goal-result');
    if(!target || target<=0 || !monthly || monthly<=0){
      toast('Enter a valid target and monthly savings amount.', 'error');
      return;
    }
    const currentSavings = totalIncome(state.transactions) - totalExpense(state.transactions);
    if(currentSavings >= target){
      resultEl.innerHTML = `
        <div class="panel-pad" style="text-align:center; padding:50px 20px;">
          ${ICONS.sparkle}
          <h3 style="margin-top:14px; font-size:20px;">You've already reached this goal!</h3>
          <p style="color:var(--ink-muted); margin-top:8px;">Your current net savings of ${fmtMoney(currentSavings)} already clears the ${fmtMoney(target)} target.</p>
        </div>`;
      fireConfetti();
      return;
    }

    const months = Math.ceil((target-currentSavings)/monthly);
    const years = Math.floor(months/12), remMonths = months%12;
    let tone, toneColor, message;
    if(months<=6){ tone='Achievable'; toneColor='var(--income)'; message="That's a very achievable short-term goal!"; }
    else if(months<=24){ tone='Steady'; toneColor='var(--warn)'; message='A solid mid-term goal — stay consistent.'; }
    else { tone='Long-term'; toneColor='var(--expense)'; message='This is a long-term goal — consider increasing your monthly savings.'; }

    resultEl.innerHTML = `
      <div class="panel-head"><div><div class="eyebrow">Projection</div><h3>Timeline to ${fmtMoney(target)}</h3></div><span class="pill" style="background:${toneColor}22; color:${toneColor}">${tone}</span></div>
      <div class="panel-pad">
        <div class="hero-figure mono" style="font-size:44px;"><span id="goal-months">0</span><span class="unit">months</span></div>
        <p class="hero-sub" style="margin-top:8px;">≈ ${years>0?years+' yr '+remMonths+' mo':months+' months'} at ${fmtMoney(monthly)}/month.</p>
        <div class="tally-track" style="margin-top:18px; height:12px;"><div class="tally-fill" data-target="100" style="background:${toneColor}"></div></div>
        <p style="margin-top:16px; color:var(--ink-muted); font-size:13px;">${message}</p>
      </div>
    `;
    const monthsEl = document.getElementById('goal-months');
    animateNumber(monthsEl, months, {decimals:0, prefix:''});
    requestAnimationFrame(()=>{ resultEl.querySelector('.tally-fill').style.width='100%'; });
    if(tone==='Achievable') fireConfetti();
  });
};

