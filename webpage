/* ================================================================
   VIEW: LEDGER
   ================================================================ */
function applyFilters(list){
  const f = ledgerFilters;
  return list.filter(t=>{
    if(f.type!=='all' && t.type!==f.type) return false;
    if(f.category!=='all' && t.category!==f.category) return false;
    if(f.from && t.date < f.from) return false;
    if(f.to && t.date > f.to) return false;
    if(f.min && t.amount < parseFloat(f.min)) return false;
    if(f.max && t.amount > parseFloat(f.max)) return false;
    if(f.keyword){
      const k = f.keyword.toLowerCase();
      const hay = (t.description+' '+t.category+' '+t.date+' '+t.id).toLowerCase();
      if(!hay.includes(k)) return false;
    }
    return true;
  });
}

function renderLedger(){
  const all = sortedTx();
  const filtered = applyFilters(all);
  const allCats = [...INCOME_CATEGORIES, ...EXPENSE_CATEGORIES.filter(c=>!INCOME_CATEGORIES.includes(c))];

  const groups = [];
  let currentMonth = null, currentGroup = null;
  filtered.forEach(t=>{
    const m = t.date.slice(0,7);
    if(m !== currentMonth){ currentMonth = m; currentGroup = { key:m, label: monthLabel(t.date), items:[] }; groups.push(currentGroup); }
    currentGroup.items.push(t);
  });

  return `
    <div class="panel panel-pad" style="margin-top:14px; display:flex; flex-wrap:wrap; gap:12px; align-items:flex-end;">
      <div class="field" style="flex:1; min-width:200px">
        <label>Search</label>
        <div class="search-wrap">${ICONS.search}<input id="f-keyword" placeholder="Description, category, ID…" value="${escapeHtml(ledgerFilters.keyword)}"></div>
      </div>
      <div class="field" style="width:130px">
        <label>Type</label>
        <select id="f-type">
          <option value="all">All</option>
          <option value="Income" ${ledgerFilters.type==='Income'?'selected':''}>Income</option>
          <option value="Expense" ${ledgerFilters.type==='Expense'?'selected':''}>Expense</option>
        </select>
      </div>
      <div class="field" style="width:160px">
        <label>Category</label>
        <select id="f-category">
          <option value="all">All</option>
          ${allCats.map(c=>`<option value="${c}" ${ledgerFilters.category===c?'selected':''}>${c}</option>`).join('')}
        </select>
      </div>
      <div class="field" style="width:140px"><label>From</label><input type="date" id="f-from" value="${ledgerFilters.from}"></div>
      <div class="field" style="width:140px"><label>To</label><input type="date" id="f-to" value="${ledgerFilters.to}"></div>
      <div class="field" style="width:100px"><label>Min</label><input class="mono-input" id="f-min" type="number" placeholder="0" value="${ledgerFilters.min}"></div>
      <div class="field" style="width:100px"><label>Max</label><input class="mono-input" id="f-max" type="number" placeholder="∞" value="${ledgerFilters.max}"></div>
      <button class="btn btn-ghost btn-sm" id="f-clear">Clear filters</button>
    </div>

    <div class="panel" style="margin-top:16px">
      <div class="panel-head">
        <div><div class="eyebrow">${filtered.length} of ${all.length} entries</div><h3>Transaction Ledger</h3></div>
      </div>
      ${filtered.length===0 ? `
        <div class="empty">${ICONS.empty}<h4>Nothing matches those filters</h4><p>Try widening your search or clearing filters to see the full ledger.</p></div>
      ` : `
      <div style="overflow-x:auto; max-height:640px; overflow-y:auto;">
      <table class="ledger-table">
        <thead><tr><th></th><th>Date</th><th>Category</th><th>Description</th><th style="text-align:right">Amount</th><th></th></tr></thead>
        <tbody>
          ${groups.map(g=>`
            <tr class="month-row"><td colspan="6">${g.label} <span style="color:var(--ink-faint); font-family:var(--font-mono); font-size:11px;">· ${g.items.length} ${g.items.length===1?'entry':'entries'}</span></td></tr>
            ${g.items.map(t=>txRow(t,false)).join('')}
          `).join('')}
        </tbody>
      </table>
      </div>
      `}
    </div>
  `;
}

afterRender.ledger = function(){
  wireRowActions();
  const bind = (id, key, evt='input') => {
    const el = document.getElementById(id);
    if(!el) return;
    el.addEventListener(evt, debounce(()=>{ ledgerFilters[key] = el.value; renderView(); }, key==='keyword' ? 250 : 0));
