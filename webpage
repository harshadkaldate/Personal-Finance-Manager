  });
  document.getElementById('export-csv').addEventListener('click', ()=>{
    const rows = [['ID','Date','Time','Type','Category','Amount','Description']];
    sortedTx().forEach(t=> rows.push([t.id,t.date,t.time,t.type,t.category,t.amount,'"'+t.description.replace(/"/g,'""')+'"']));
    const csv = rows.map(r=>r.join(',')).join('\n');
    downloadFile('finance-manager-transactions.csv', csv, 'text/csv');
  });
};
function downloadFile(filename, content, mime){
  const blob = new Blob([content], {type:mime});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = filename; document.body.appendChild(a); a.click();
  a.remove(); URL.revokeObjectURL(url);
  toast('Downloaded ' + filename, 'success');
}

