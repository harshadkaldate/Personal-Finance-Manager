   ============================================================ */
.sound-toggle{ width:36px; height:36px; border-radius: var(--radius-md); display:flex; align-items:center; justify-content:center; border:1px solid var(--line-strong); background: rgba(15,23,42,0.03); cursor:pointer; color: var(--ink-muted); flex-shrink:0; }
.sound-toggle:hover{ color: var(--ink); }
.sound-toggle svg{ width:15px;height:15px; }
