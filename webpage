  renderSankey();
  const recapBtn = document.getElementById('btn-open-recap');
  if(recapBtn) recapBtn.addEventListener('click', openRecap);
};

/* ================================================================
   SPENDING HEATMAP (GitHub-contributions style)
   ================================================================ */
function renderHeatmap(){
  const host = document.getElementById('heatmap-host');
  if(!host) return;

  const weeks = 18;
  const totalDays = weeks*7;
  const today = new Date();
  today.setHours(0,0,0,0);
  const start = new Date(today);
  start.setDate(start.getDate() - (totalDays-1) - today.getDay());

  const dayTotals = {};
  state.transactions.forEach(t=>{
    if(t.type!=='Expense' || isTransfer(t)) return;
    dayTotals[t.date] = (dayTotals[t.date]||0) + t.amount;
  });
  const maxVal = Math.max(1, ...Object.values(dayTotals));

  if(Object.keys(dayTotals).length===0){
    host.innerHTML = `<div class="empty" style="padding:24px 10px">${ICONS.empty}<p>No expenses yet — your heatmap fills in as you log them.</p></div>`;
    return;
  }

  const cells = [];
  for(let i=0;i<totalDays;i++){
    const d = new Date(start);
    d.setDate(d.getDate()+i);
    const iso = d.toISOString().slice(0,10);
    const val = dayTotals[iso] || 0;
    const intensity = val>0 ? Math.max(0.16, Math.min(1, val/maxVal)) : 0;
    const isFuture = d > today;
    const color = isFuture ? 'transparent' : (val>0 ? `color-mix(in srgb, var(--expense) ${Math.round(intensity*100)}%, var(--bg-inset))` : 'var(--bg-inset)');
    cells.push(`<div class="heatmap-cell" style="background:${color}" title="${fmtDateDisplay(iso)} · ${fmtMoney(val)}"></div>`);
  }
  host.innerHTML = `
    <div class="heatmap-grid">${cells.join('')}</div>
    <div class="heatmap-legend">
      <span>Less</span>
      <div class="heatmap-cell" style="background:var(--bg-inset)"></div>
      <div class="heatmap-cell" style="background:color-mix(in srgb, var(--expense) 30%, var(--bg-inset))"></div>
      <div class="heatmap-cell" style="background:color-mix(in srgb, var(--expense) 60%, var(--bg-inset))"></div>
      <div class="heatmap-cell" style="background:var(--expense)"></div>
      <span>More</span>
    </div>
  `;
}

/* ================================================================
   SANKEY-STYLE MONEY FLOW DIAGRAM
   Hand-rolled 3-column flow (income sources -> center -> expense
   categories), proportional node heights, bezier ribbons.
   ================================================================ */
function renderSankey(){
  const host = document.getElementById('sankey-host');
  if(!host) return;

  const incomeSrc = categoryTotals('Income').slice(0,6);
  const expenseSrc = categoryTotals('Expense').slice(0,6);
  if(incomeSrc.length===0 && expenseSrc.length===0){
    host.innerHTML = `<div class="empty" style="padding:24px 10px">${ICONS.empty}<p>Add income and expenses to see how money flows.</p></div>`;
    return;
  }

  const W = 720, H = 300, colX = [70, 360, 650], nodeW = 14;
  const incomeTotal = incomeSrc.reduce((s,c)=>s+c[1],0) || 1;
  const expenseTotal = expenseSrc.reduce((s,c)=>s+c[1],0) || 1;
  const midTotal = Math.max(incomeTotal, expenseTotal, 1);
  const topPad = 20, usableH = H - topPad*2;

  function layout(nodes, total){
    let y = topPad;
    return nodes.map(([name,val])=>{
      const h = Math.max(6, (val/total) * usableH);
      const node = { name, val, y, h };
      y += h + 8;
      return node;
    });
  }
  const leftNodes = layout(incomeSrc, midTotal);
  const rightNodes = layout(expenseSrc, midTotal);
  const centerH = Math.min(usableH, Math.max(...leftNodes.map(n=>n.y+n.h), 0) - topPad, Math.max(...rightNodes.map(n=>n.y+n.h), 0) - topPad) || usableH*0.6;
  const centerNode = { y: topPad, h: Math.max(...leftNodes.map(n=>n.y+n.h-topPad), ...rightNodes.map(n=>n.y+n.h-topPad), 20) };

  function ribbon(x1,y1,h1,x2,y2,h2,color){
    const mx = (x1+x2)/2;
    return `<path d="M${x1},${y1} C${mx},${y1} ${mx},${y2} ${x2},${y2} L${x2},${y2+h2} C${mx},${y2+h2} ${mx},${y1+h1} ${x1},${y1+h1} Z" fill="${color}" opacity="0.4"/>`;
  }

  let svg = `<svg viewBox="0 0 ${W} ${H}" width="100%" style="min-width:560px">`;
  // center trunk
  svg += `<rect x="${colX[1]-nodeW/2}" y="${centerNode.y}" width="${nodeW}" height="${centerNode.h}" rx="3" fill="var(--gold)"/>`;
  svg += `<text x="${colX[1]}" y="${centerNode.y - 8}" text-anchor="middle" class="sankey-node-label strong">Balance</text>`;

  leftNodes.forEach(n=>{
    const color = catColor(n.name);
    svg += ribbon(colX[0]+nodeW/2, n.y, n.h, colX[1]-nodeW/2, n.y, n.h, color);
    svg += `<rect x="${colX[0]-nodeW/2}" y="${n.y}" width="${nodeW}" height="${n.h}" rx="3" fill="${color}"/>`;
    svg += `<text x="${colX[0]-nodeW/2-8}" y="${n.y+n.h/2+3}" text-anchor="end" class="sankey-node-label">${escapeHtml(n.name)}</text>`;
  });
  rightNodes.forEach(n=>{
    const color = catColor(n.name);
    svg += ribbon(colX[1]+nodeW/2, n.y, n.h, colX[2]-nodeW/2, n.y, n.h, color);
    svg += `<rect x="${colX[2]-nodeW/2}" y="${n.y}" width="${nodeW}" height="${n.h}" rx="3" fill="${color}"/>`;
    svg += `<text x="${colX[2]+nodeW/2+8}" y="${n.y+n.h/2+3}" text-anchor="start" class="sankey-node-label">${escapeHtml(n.name)}</text>`;
  });
  svg += `<text x="${colX[0]}" y="${H-4}" text-anchor="middle" class="sankey-node-label" style="opacity:0.6">Income sources</text>`;
  svg += `<text x="${colX[2]}" y="${H-4}" text-anchor="middle" class="sankey-node-label" style="opacity:0.6">Where it goes</text>`;
  svg += `</svg>`;
  host.innerHTML = svg;
}

/* ================================================================
   VIEW: BUDGET
   ================================================================ */
function renderBudget(){
  const thisMonth = todayISO().slice(0,7);
  const monthTx = state.transactions.filter(t=>t.date.startsWith(thisMonth));
  const spent = totalExpense(monthTx);
  const budget = state.monthlyBudget || 0;
  const frac = budget>0 ? spent/budget : 0;
  const remaining = budget - spent;
  const color = frac>=1 ? '#FF5262' : frac>=0.9 ? '#FF5262' : frac>=0.8 ? '#FFA000' : '#00B899';
  const statusText = frac>=1 ? 'Budget exceeded' : frac>=0.9 ? 'Critical — nearly out of budget' : frac>=0.8 ? 'Warning — approaching your limit' : 'Within budget';

  const months = lastNMonths(6);
  const hist = months.map(m=>{
    const t = totalExpense(state.transactions.filter(x=>x.date.startsWith(m.key)));
    return { label:m.label, val: budget>0 ? Math.min(t/budget*100,130) : 0, spent:t };
  });

  return `
    <div class="grid grid-12" style="margin-top:14px">
      <div class="panel span-5">
        <div class="panel-head"><div><div class="eyebrow">${monthLabel(todayISO())}</div><h3>Budget Gauge</h3></div></div>
        <div class="panel-pad gauge-wrap">
          <svg width="240" height="140" viewBox="0 0 240 140">
            <path d="M20 130 A100 100 0 0 1 220 130" fill="none" stroke="rgba(15,23,42,0.08)" stroke-width="16" stroke-linecap="round"/>
            <path id="gauge-arc" d="M20 130 A100 100 0 0 1 220 130" fill="none" stroke="${color}" stroke-width="16" stroke-linecap="round"
              stroke-dasharray="314" stroke-dashoffset="314"/>
          </svg>
          <div class="gauge-value mono" style="color:${color}">${budget>0 ? Math.round(frac*100)+'%' : '—'}</div>
          <div class="gauge-label">${budget>0 ? statusText : 'No budget set'}</div>
        </div>
        <div class="divider" style="margin:0 22px"></div>
        <div class="panel-pad" style="display:flex; flex-direction:column; gap:12px;">
          <div class="field"><label>Monthly budget</label>
            <div style="display:flex; gap:8px;">
              <input class="mono-input" id="budget-input" type="number" step="0.01" min="0" placeholder="0.00" value="${budget||''}">
              <button class="btn btn-primary btn-sm" id="budget-save">Save</button>
            </div>
          </div>
          ${budget>0 ? `
          <div class="kpi-row" style="justify-content:space-between; font-size:13px;"><span style="color:var(--ink-muted)">Spent this month</span><span class="mono" style="font-weight:600">${fmtMoney(spent)}</span></div>
          <div class="kpi-row" style="justify-content:space-between; font-size:13px;"><span style="color:var(--ink-muted)">Remaining</span><span class="mono" style="font-weight:600; color:${remaining>=0?'var(--income)':'var(--expense)'}">${fmtMoney(remaining)}</span></div>
          ` : ''}
        </div>
      </div>

      <div class="panel span-7">
        <div class="panel-head"><div><div class="eyebrow">Last 6 months</div><h3>Budget Usage Trend</h3></div></div>
        <div class="panel-pad">
          ${budget<=0 ? `<div class="empty" style="padding:40px 10px">${ICONS.budget}<h4>Set a budget to unlock this view</h4><p>Once you set a monthly budget, we'll track how each month compares.</p></div>` :
          hist.map(h=>{
            const c = h.val>=100?'#FF5262':h.val>=80?'#FFA000':'#00B899';
            return `<div class="tally-row"><span class="cat-name">${h.label}</span><div class="tally-track"><div class="tally-fill" data-target="${Math.min(h.val,100)}" style="background:${c}"></div></div><span class="tally-val">${fmtMoney(h.spent)}</span></div>`;
          }).join('')}
        </div>
      </div>
    </div>
  `;
}
afterRender.budget = function(){
  const input = document.getElementById('budget-input');
  const saveBtn = document.getElementById('budget-save');
  if(saveBtn) saveBtn.addEventListener('click', async ()=>{
    const val = parseFloat(input.value);
