function openAccountDrawer(editId){
  const existing = editId ? state.accounts.find(a=>a.id===editId) : null;
  let scrim = document.getElementById('drawer-scrim');
  if(!scrim){ scrim = document.createElement('div'); scrim.id='drawer-scrim'; scrim.className='scrim'; document.body.appendChild(scrim); }
  let drawer = document.getElementById('tx-drawer');
  if(!drawer){ drawer = document.createElement('div'); drawer.id='tx-drawer'; drawer.className='drawer'; document.body.appendChild(drawer); }

  drawer.innerHTML = `
    <div class="drawer-head"><h3>${existing?'Edit Account':'New Account'}</h3><button class="icon-btn" id="drawer-close">${ICONS.x}</button></div>
    <div class="drawer-body">
      <div class="field"><label>Account name</label><input id="acct-name" placeholder="e.g. Checking, Cash, Credit Card" value="${existing?escapeHtml(existing.name):''}"></div>
      <div class="field"><label>Starting balance</label><input class="mono-input" id="acct-start" type="number" step="0.01" value="${existing?existing.startingBalance:'0'}"></div>
      <div class="field"><label>Color</label>
        <div style="display:flex; gap:8px; flex-wrap:wrap;" id="acct-color-swatches">
          ${ACCOUNT_PALETTE.map(c=>`<div data-color="${c}" style="width:28px;height:28px;border-radius:8px;background:${c};cursor:pointer;border:2px solid ${existing&&existing.color===c ? '#0F172A' : 'transparent'};"></div>`).join('')}
        </div>
      </div>
    </div>
    <div class="drawer-foot">
      <button class="btn btn-ghost" id="drawer-cancel">Cancel</button>
      <button class="btn btn-primary" id="drawer-save">${existing?'Save Changes':'Add Account'}</button>
    </div>
  `;
  let chosenColor = existing ? existing.color : ACCOUNT_PALETTE[state.accounts.length % ACCOUNT_PALETTE.length];
  document.querySelectorAll('#acct-color-swatches [data-color]').forEach(sw=>{
    sw.addEventListener('click', ()=>{
      chosenColor = sw.dataset.color;
      document.querySelectorAll('#acct-color-swatches [data-color]').forEach(s=> s.style.borderColor = s===sw ? '#0F172A' : 'transparent');
    });
  });
  document.getElementById('drawer-close').addEventListener('click', closeTxDrawer);
  document.getElementById('drawer-cancel').addEventListener('click', closeTxDrawer);
  document.getElementById('drawer-save').addEventListener('click', async ()=>{
    const nameEl = document.getElementById('acct-name');
    const startEl = document.getElementById('acct-start');
    if(!nameEl.value.trim()){ nameEl.closest('.field').classList.add('invalid'); return; }
    if(existing){
      existing.name = nameEl.value.trim();
      existing.startingBalance = parseFloat(startEl.value)||0;
      existing.color = chosenColor;
      toast('Account updated.', 'success');
    } else {
      state.accounts.push({ id: state.nextAccountId++, name: nameEl.value.trim(), startingBalance: parseFloat(startEl.value)||0, color: chosenColor });
      toast('Account added.', 'success');
    }
    await saveState();
    closeTxDrawer();
    renderShell(); renderView();
  });
  requestAnimationFrame(()=>{ scrim.classList.add('open'); drawer.classList.add('open'); });
  scrim.onclick = closeTxDrawer;
}

function confirmDeleteAccount(id){
  const hasTx = state.transactions.some(t=>t.accountId===id);
  showModal({
    title: 'Delete this account?',
    body: hasTx ? `Its transactions will move to your remaining default account. This can't be undone.` : `This account has no transactions yet.`,
    confirmLabel:'Delete', confirmClass:'btn-danger',
    onConfirm: async ()=>{
      state.accounts = state.accounts.filter(a=>a.id!==id);
      const fallback = state.accounts[0].id;
      if(state.defaultAccountId===id) state.defaultAccountId = fallback;
      state.transactions.forEach(t=>{ if(t.accountId===id) t.accountId = fallback; });
      await saveState();
      toast('Account deleted.', 'success');
      renderShell(); renderView();
    }
  });
}

function openTransferModal(){
  let wrap = document.getElementById('modal-wrap');
  if(!wrap){ wrap = document.createElement('div'); wrap.id='modal-wrap'; wrap.className='modal-wrap'; document.body.appendChild(wrap); }
  wrap.innerHTML = `
    <div class="modal">
      <h3>Transfer Between Accounts</h3>
      <div style="display:flex; flex-direction:column; gap:12px; margin-top:14px;">
        <div class="field"><label>From</label><select id="xfer-from">${state.accounts.map(a=>`<option value="${a.id}">${escapeHtml(a.name)}</option>`).join('')}</select></div>
        <div class="field"><label>To</label><select id="xfer-to">${state.accounts.map(a=>`<option value="${a.id}">${escapeHtml(a.name)}</option>`).join('')}</select></div>
        <div class="field"><label>Amount</label><input class="mono-input" id="xfer-amount" type="number" step="0.01" min="0.01" placeholder="0.00"></div>
      </div>
      <div class="modal-actions">
        <button class="btn btn-ghost" id="modal-cancel">Cancel</button>
        <button class="btn btn-primary" id="xfer-confirm">Transfer</button>
      </div>
    </div>`;
  document.getElementById('modal-cancel').addEventListener('click', ()=> wrap.classList.remove('open'));
  document.getElementById('xfer-confirm').addEventListener('click', async ()=>{
    const fromId = Number(document.getElementById('xfer-from').value);
    const toId = Number(document.getElementById('xfer-to').value);
    const amount = parseFloat(document.getElementById('xfer-amount').value);
    if(!amount || amount<=0){ toast('Enter a transfer amount greater than zero.', 'error'); return; }
    if(fromId===toId){ toast('Choose two different accounts.', 'error'); return; }
    const date = todayISO(), time = nowHM();
    state.transactions.push({ id: uid(), date, time, type:'Expense', category:TRANSFER_CATEGORY, amount, description:`Transfer to ${accountName(toId)}`, accountId: fromId });
    state.transactions.push({ id: uid(), date, time, type:'Income', category:TRANSFER_CATEGORY, amount, description:`Transfer from ${accountName(fromId)}`, accountId: toId });
    await saveState();
    wrap.classList.remove('open');
    toast('Transfer complete.', 'success');
    renderShell(); renderView();
  });
  requestAnimationFrame(()=> wrap.classList.add('open'));
}

