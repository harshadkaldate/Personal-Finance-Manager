function enableTilt(container){
  if(reduceMotion) return;
  container.querySelectorAll('.tilt').forEach(card=>{
    card.addEventListener('mousemove', e=>{
      const r = card.getBoundingClientRect();
      const px = (e.clientX - r.left)/r.width - 0.5;
      const py = (e.clientY - r.top)/r.height - 0.5;
      card.style.transform = `perspective(600px) rotateX(${(-py*5).toFixed(2)}deg) rotateY(${(px*7).toFixed(2)}deg) translateY(-2px)`;
    });
    card.addEventListener('mouseleave', ()=>{ card.style.transform = ''; });
  });
}

function animateNumber(el, to, opts={}){
  const prefix = opts.prefix || '';
  const decimals = opts.decimals ?? 2;
  if(reduceMotion){ el.textContent = prefix + to.toLocaleString(undefined,{minimumFractionDigits:decimals,maximumFractionDigits:decimals}); return; }
  const from = 0;
  const dur = 900;
  const start = performance.now();
  function frame(now){
    const p = Math.min(1, (now-start)/dur);
    const eased = 1 - Math.pow(1-p, 3);
    const val = from + (to-from)*eased;
    el.textContent = prefix + val.toLocaleString(undefined,{minimumFractionDigits:decimals,maximumFractionDigits:decimals});
    if(p<1) requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
}

