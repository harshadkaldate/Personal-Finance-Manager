    state.monthlyBudget = Math.round(val*100)/100;
    await saveState();
    toast('Budget updated.', 'success');
    renderShell(); renderView();
  });
  requestAnimationFrame(()=>{
    document.querySelectorAll('.tally-fill[data-target]').forEach(el=> el.style.width = el.dataset.target+'%');
    const arc = document.getElementById('gauge-arc');
    if(arc){
      const thisMonth = todayISO().slice(0,7);
      const spent = totalExpense(state.transactions.filter(t=>t.date.startsWith(thisMonth)));
      const frac = state.monthlyBudget>0 ? Math.min(spent/state.monthlyBudget,1) : 0;
      const len = 314;
      arc.style.transition = reduceMotion ? 'none' : 'stroke-dashoffset 1000ms cubic-bezier(.22,.68,.16,1)';
      requestAnimationFrame(()=>{ arc.style.strokeDashoffset = String(len - (len*frac)); });
    }
  });
};

