function isTransfer(t){ return t.category === TRANSFER_CATEGORY; }
function totalIncome(list){ return list.filter(t=>t.type==='Income' && !isTransfer(t)).reduce((s,t)=>s+t.amount,0); }
function totalExpense(list){ return list.filter(t=>t.type==='Expense' && !isTransfer(t)).reduce((s,t)=>s+t.amount,0); }

function sortedTx(){
  return [...state.transactions].sort((a,b)=>{
    if(a.date !== b.date) return a.date < b.date ? 1 : -1;
    return a.time < b.time ? 1 : (a.time > b.time ? -1 : 0);
  });
}

function categoryTotals(type){
  const map = {};
  state.transactions.filter(t=>t.type===type && !isTransfer(t)).forEach(t=>{
    map[t.category] = (map[t.category]||0) + t.amount;
  });
  return Object.entries(map).sort((a,b)=>b[1]-a[1]);
}

